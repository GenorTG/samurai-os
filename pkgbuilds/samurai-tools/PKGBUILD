# Maintainer: Samurai OS <build@smart-samurai.pl>
# The build driver stages executors and interventions from updates/ and the two
# catalog files from catalog/ beside this file (see ci/build-repo.sh); the shell
# completions live beside this file. tests/unit/test_installer_apps.py checks
# every source against its origin, so regenerate sha256sums after each change:
#   for f in ...; do sha256sum "$f"; done   (or updpkgsums in the staged dir)
pkgname=samurai-tools
pkgver=0.3.0
pkgrel=2
pkgdesc="Samurai OS updater, CLI executors, app catalog tool, update notifier and shell completions"
arch=(any)
url="https://github.com/GenorTG/samurai-os"
license=('PolyForm-Noncommercial-1.0.0' 'GPL-3.0-or-later')
depends=(
    bash
    coreutils
    curl
    findutils
    gawk
    grep
    pacman
    pacman-contrib   # checkupdates (samurai-notifier), paccache (samurai-update housekeeping)
    python
    sed
    systemd
    util-linux
)
optdepends=('sudo: samurai apps install/remove as a normal user'
            'polkit: pkexec fallback when sudo is missing'
            'flatpak: Flatpak-only catalog apps'
            'libnotify: desktop notifications from samurai-notifier'
            'arch-audit: security-fix counts in samurai-notifier'
            'snapper: rollback point before samurai update (samurai snap)')
install=samurai-tools.install
source=(
    samurai
    samurai-update
    samurai-snap
    samurai-rescue
    samurai-apps
    samurai-notifier
    samurai-notifier.service
    samurai-notifier.timer
    samurai.bash
    samurai.fish
    0001-update-mechanism-demo.toml
    0001-update-mechanism-demo.sh
    garuda-setup-wizard.toml
    samurai.toml
    LICENSE
)
sha256sums=(
    '60847c2cd58874fb9843f3ff80fd87b54719156a38a2002908404f3ca4585483'
    '675eb8a6dc64bac82def35ecddfa786a7055ac916bdd74d10da118df5490f292'
    '28ad946a28432d3d820761718c52473f51da5ba03c7a3583a4d6494ae52ad76c'
    'b32f62e974cfe2c4db20edb9c70f9656e91d9a06c08c1e23e779693061bd5da9'
    '11f2f369b8ecd8588988f465c929f6d8ebf95364823dec723565edfadd744c90'
    '369abd6cc730ee7a59c6670a92d80c90573e2b7339525ada42b0e3eb45bd23fc'
    '6d477d89600ea6318ae20de5503954626a6d63b3c8ec939e569b1342e61829f3'
    '832e6dede8d1bf108c41c2eb9d856cc7bc565c73c280e79359e181feb2996eac'
    'b17a50891125d7bede74834aecf7440dd9200447f164185bea94995cfb843dd4'
    '731d4cec9bd3dbb740153fda0f09f788f917ec67a669c81ae55f8281a9cd5ee2'
    '3fbf554fe2729136489e72fe11a162bd17d25cb170fb72863c793d0664eeb877'
    '60a47ce64a90aab079c0a8d50c126ee795fd9263d0304a3b63128862066c7331'
    'c03375cb3acd7ead49fbe319a44a596b493b1e716388a10346271b33ca47fdf8'
    '36271dc080efec183fdaf93d7618c72835bda14191a1150515e9e524421e12ac'
    '1be06492345bb03a60d13d23d744d979cc7cf1ce154da5227651f8dd78f25017'
)

package() {
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    cd "$srcdir"
    install -Dm755 samurai "$pkgdir/usr/local/bin/samurai"
    install -Dm755 samurai-update "$pkgdir/usr/local/bin/samurai-update"
    install -Dm755 samurai-snap "$pkgdir/usr/local/bin/samurai-snap"
    install -Dm755 samurai-rescue "$pkgdir/usr/local/bin/samurai-rescue"
    install -Dm755 samurai-apps "$pkgdir/usr/local/bin/samurai-apps"
    install -Dm644 garuda-setup-wizard.toml "$pkgdir/usr/share/samurai/catalog/garuda-setup-wizard.toml"
    install -Dm644 samurai.toml "$pkgdir/usr/share/samurai/catalog/samurai.toml"
    install -Dm755 samurai-notifier "$pkgdir/usr/local/bin/samurai-notifier"
    install -Dm644 samurai-notifier.service "$pkgdir/usr/lib/systemd/user/samurai-notifier.service"
    install -Dm644 samurai-notifier.timer "$pkgdir/usr/lib/systemd/user/samurai-notifier.timer"
    install -Dm644 samurai.bash "$pkgdir/usr/share/bash-completion/completions/samurai"
    install -Dm644 samurai.fish "$pkgdir/usr/share/fish/vendor_completions.d/samurai.fish"
    install -Dm644 0001-update-mechanism-demo.toml \
        "$pkgdir/usr/lib/samurai/interventions/0001-update-mechanism-demo.toml"
    install -Dm755 0001-update-mechanism-demo.sh \
        "$pkgdir/usr/lib/samurai/interventions/0001-update-mechanism-demo.sh"
    # `samurai version` reads this before falling back to pacman -Q
    printf '%s-%s\n' "$pkgver" "$pkgrel" > "$pkgdir/usr/share/samurai/tools-version"
}
