# shellcheck shell=bash
# Services are enabled on first install only: a later upgrade never re-enables
# a unit the user turned off.
post_install() {
    local unit
    for unit in ananicy-cpp.service irqbalance.service systemd-oomd.service power-profiles-daemon.service; do
        systemctl enable "$unit" >/dev/null 2>&1 || echo "warning: could not enable $unit"
    done
}
