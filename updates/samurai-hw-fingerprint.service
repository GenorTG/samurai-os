[Unit]
Description=Samurai OS hardware change detection (read-only on the hardware)
Documentation=https://github.com/GenorTG/samurai-os/blob/main/docs/specs/07-HARDWARE-AND-DRIVERS.md
After=local-fs.target

[Service]
Type=oneshot
# compares the PCI devices with the last accepted state and writes a notice; never installs
ExecStart=/usr/local/bin/samurai hw fingerprint --check
StateDirectory=samurai
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
