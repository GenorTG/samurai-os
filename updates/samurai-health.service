[Unit]
Description=Samurai OS health check (read-only)
Documentation=man:samurai(1)
After=local-fs.target

[Service]
Type=oneshot
# exit 1 means "issues found", not "the check failed": do not mark the unit failed,
# or services.failed would report the health check itself
SuccessExitStatus=1
ExecStart=/usr/local/bin/samurai health --json --write
StateDirectory=samurai
Nice=10
IOSchedulingClass=idle
# the checks only read; the report goes to StateDirectory
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# not ProtectKernelModules=yes: it hides /usr/lib/modules, which the kernel and driver checks read
CapabilityBoundingSet=~CAP_SYS_MODULE
SystemCallFilter=~@module
ProtectControlGroups=yes
RestrictSUIDSGID=yes
