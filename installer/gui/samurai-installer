#!/usr/bin/env python3
"""Samurai OS graphical installer (spec 08). Runs unprivileged in the live Plasma session."""
from __future__ import annotations

import fcntl
import os
import pathlib
import sys

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

from PySide6.QtCore import QUrl  # noqa: E402
from PySide6.QtGui import QIcon  # noqa: E402
from PySide6.QtQml import QQmlApplicationEngine  # noqa: E402
from PySide6.QtQuickControls2 import QQuickStyle  # noqa: E402
from PySide6.QtWidgets import QApplication  # noqa: E402

from samurai_installer.backend import Backend  # noqa: E402
from samurai_installer.engine import Tools  # noqa: E402


def single_instance() -> object | None:
    """Hold a per-session lock; a second wizard would fight over the same disk."""
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        return sys.stdin
    handle = open(pathlib.Path(runtime) / "samurai-installer.lock", "w", encoding="utf-8")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        handle.close()
        return None
    return handle


def main() -> int:
    lock = single_instance()
    if lock is None:
        print("the installer is already running", file=sys.stderr)
        return 1
    # QApplication (not QGuiApplication): the Plasma controls style needs widgets
    app = QApplication(sys.argv)
    app.setApplicationName("samurai-installer")
    app.setApplicationDisplayName("Install Samurai OS")
    app.setDesktopFileName("samurai-installer")
    app.setWindowIcon(QIcon.fromTheme("system-software-install"))
    if not os.environ.get("QT_QUICK_CONTROLS_STYLE"):
        QQuickStyle.setStyle("org.kde.desktop")
        QQuickStyle.setFallbackStyle("Fusion")
    backend = Backend(Tools())
    qml = QQmlApplicationEngine()
    qml.rootContext().setContextProperty("installer", backend)
    qml.load(QUrl.fromLocalFile(str(HERE / "qml" / "Main.qml")))
    if not qml.rootObjects():
        return 1
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
