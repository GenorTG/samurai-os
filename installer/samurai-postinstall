#!/usr/bin/env bash
# samurai-postinstall — applies a validated install profile inside the target
# chroot (spec 08). Idempotent-ish, every step logged to /var/log/samurai/install.log
# (and it inherits the driver's tee when driven by samurai-install).
#
# Security posture: profile is validated BEFORE we get here (the driver calls
# validate-profile.py); values are never shell-interpolated beyond quoting;
# sudoers is checked with visudo -c; root is locked unless root_locked=false.
set -euo pipefail

PROFILE="${1:?usage: samurai-postinstall /path/to/profile.toml}"
[ -f "$PROFILE" ] || { echo "profile not found: $PROFILE" >&2; exit 1; }

log() { printf '%s %s\n' "$(date -Is)" "$*"; }
log "samurai-postinstall starting"

read -r HOSTNAME TZ LOCALE KB KERNELS BLDR \
    < <(python3 - "$PROFILE" <<'PY'
import sys, tomllib
p = tomllib.loads(open(sys.argv[1]).read())
s, b = p.get("system", {}), p.get("boot", {})
print(s.get("hostname", "samurai"), s.get("timezone", "UTC"),
      s.get("locale", "en_US.UTF-8"), s.get("keyboard", "us"),
      " ".join(b.get("kernels", ["linux"])), b.get("bootloader", "systemd-boot"))
PY
) || exit 1
read -r UNAME USHELL UPWHASH < <(python3 - "$PROFILE" <<'PY'
import sys, tomllib
p = tomllib.loads(open(sys.argv[1]).read())
u = p.get("user", {})
print(u.get("name", "samurai"), u.get("shell", "bash"), u.get("password_hash", ""))
PY
) || exit 1
read -r ENCRYPT AUTOKEY < <(python3 - "$PROFILE" <<'PY'
import sys, tomllib
p = tomllib.loads(open(sys.argv[1]).read())
d = p.get("disk", {})
print(int(bool(d.get("encryption", True))), int(bool(d.get("auto_unlock_keyfile", False))))
PY
) || exit 1
read -r -a PACKAGES < <(python3 - "$PROFILE" <<'PY'
import sys, tomllib
p = tomllib.loads(open(sys.argv[1]).read())
print(" ".join(p.get("packages", {}).get("install", [])))
PY
) || exit 1

### identity ###
log "identity: hostname=$HOSTNAME tz=$TZ locale=$LOCALE"
echo "$HOSTNAME" > /etc/hostname
ln -sfn "/usr/share/zoneinfo/$TZ" /etc/localtime
sed -i "s|^#\(${LOCALE//./\\.}\)|\1|" /etc/locale.gen
grep -q "^$LOCALE" /etc/locale.gen || echo "$LOCALE UTF-8" >> /etc/locale.gen
locale-gen
echo "LANG=$LOCALE" > /etc/locale.conf
printf 'KEYMAP=%s\n' "$KB" > /etc/vconsole.conf
cat > /etc/hosts <<EOF
127.0.0.1	localhost
::1		localhost
127.0.1.1	$HOSTNAME.localdomain	$HOSTNAME
EOF

### [samurai] repo (spec 02): key + mirrorlist baked into the live ISO ###
log "repos: enabling [samurai]"
pacman-key --init
if [ -f /usr/share/samurai/build-key.txt ]; then
    pacman-key --add /usr/share/samurai/build-key.txt
    pacman-key --lsign-key DFE8C148C042AA3C199AAEA08436E12731EDD3FA
fi
if [ -f /usr/share/samurai/samurai-mirrorlist ]; then
    install -m644 /usr/share/samurai/samurai-mirrorlist /etc/pacman.d/samurai-mirrorlist
fi
sed -i '/^\[core\]/i [samurai]\nInclude = /etc/pacman.d/samurai-mirrorlist\nSigLevel = Required DatabaseRequired' /etc/pacman.conf
pacman -Syy

if [ "${#PACKAGES[@]}" -gt 0 ]; then
    log "installing [samurai] packages: ${PACKAGES[*]}"
    pacman -S --noconfirm --needed "${PACKAGES[@]}"
fi

### users ###
if ! id -u "$UNAME" >/dev/null 2>&1; then
    # The profile may carry a crypt password hash (sha512) for unattended
    # installs; plaintext passwords are FORBIDDEN in profiles. Interactive
    # installs prompt instead. A generated password lands at 0600 in /root.
    if [ -n "$UPWHASH" ]; then
        useradd -m -G wheel -s "/bin/$USHELL" "$UNAME"
        usermod -p "$UPWHASH" "$UNAME"
        log "user $UNAME created (password from profile hash)"
    else
        genpass() { tr -dc 'A-Za-z0-9' </dev/urandom | head -c 24; }
        UPASS="$(genpass)"
        useradd -m -G wheel -s "/bin/$USHELL" "$UNAME"
        printf '%s:%s\n' "$UNAME" "$UPASS" | chpasswd
        umask 077 && printf '%s : %s\n' "$UNAME" "$UPASS" > /root/initial-credentials && umask 022
        log "user $UNAME created (initial password in /root/initial-credentials, 0600)"
    fi
fi
passwd -l root || true

# wheel sudo, verified before activation
cat > /etc/sudoers.d/10-wheel <<'EOF'
%wheel ALL=(ALL:ALL) ALL
EOF
chmod 440 /etc/sudoers.d/10-wheel
visudo -c -q || { rm -f /etc/sudoers.d/10-wheel; log "FATAL: sudoers check failed"; exit 1; }

### mkinitcpio + bootloader ###
HOOKS="base systemd autodetect modconf kms keyboard sd-vconsole block filesystems fsck"
[ "$ENCRYPT" -eq 1 ] && HOOKS="base systemd autodetect modconf kms keyboard sd-vconsole sd-encrypt block filesystems fsck"
mkdir -p /etc/mkinitcpio.conf.d
cat > /etc/mkinitcpio.conf.d/10-samurai.conf <<EOF
HOOKS=($HOOKS)
EOF
for k in $KERNELS; do
    log "mkinitcpio for $k"
    mkinitcpio --preset "$k" 2>&1 | tail -2
done

ROOT_UUID=$(blkid -s UUID -o value "$(findmnt -n -o SOURCE / | sed 's/\[.*\]$//' | head -1)")
ESP_UUID=$(blkid -s UUID -o value "$(findmnt -n -o SOURCE /boot | head -1)")
if [ "$BLDR" = "systemd-boot" ]; then
    log "bootloader: systemd-boot"
    bootctl --esp-path=/boot install
    mkdir -p /boot/loader/entries
    printf 'timeout 5\ndefault %s.conf\n' "$(echo "$KERNELS" | head -1)" > /boot/loader/loader.conf
    kopts="root=UUID=$ROOT_UUID rw"
    if [ "$ENCRYPT" -eq 1 ]; then
        LUKS_UUID=$(blkid -s UUID -o value $(lsblk -no pkname /dev/mapper/samurai-root 2>/dev/null || true) 2>/dev/null || true)
        [ -n "$LUKS_UUID" ] && kopts="$kopts rd.luks.uuid=$LUKS_UUID"
        if [ "$AUTOKEY" -eq 1 ] && [ -f /boot/keys/samurai.key ]; then
            kopts="$kopts rd.luks.key=/keys/samurai.key:UUID=$ESP_UUID"
        fi
    fi
    for k in $KERNELS; do
        cat > "/boot/loader/entries/samurai-$k.conf" <<EOF
title   Samurai OS ($k)
sort-key samurai-01
linux   /vmlinuz-$k
initrd  /initramfs-$k.img
options $kopts
EOF
    done
else
    log "bootloader $BLDR lands with milestone M4 (Limine); systemd-boot kept as M2 fallback"
fi

### services ###
log "services"
systemctl enable qemu-guest-agent.service 2>/dev/null || true
systemctl enable systemd-networkd.service systemd-resolved.service

### fingerprint + install info ###
mkdir -p /var/lib/samurai
(lspci -nn 2>/dev/null; lsusb 2>/dev/null) | sed 's/^/  /' > /var/lib/samurai/hw-fingerprint
cp "$PROFILE" /var/lib/samurai/install-profile.toml
python3 - <<'PY' > /var/lib/samurai/install-info.json
import json, os, platform, time
print(json.dumps({"version": 1, "arch": platform.machine(),
                  "completed": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                  "builder": "samurai-postinstall M2"}, indent=1))
PY

log "samurai-postinstall complete"
