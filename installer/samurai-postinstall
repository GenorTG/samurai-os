#!/usr/bin/env bash
# samurai-postinstall — applies a validated install profile inside the target
# chroot (spec 08). Idempotent-ish, every step logged to /var/log/samurai/install.log
# (and it inherits the driver's tee when driven by samurai-install).
#
# Security posture: profile is validated BEFORE we get here (the driver calls
# validate-profile.py); values are never shell-interpolated beyond quoting and
# every profile-derived argument list is terminated with `--`; sudoers is
# checked with visudo -c; root is always locked; nothing that fails is hidden
# behind `|| true` unless the failure is a documented no-op.
# Environment (set by samurai-install):
#   SAMURAI_CHROOT=1            running inside the install chroot
#   SAMURAI_OFFLINE=1           offline medium: no repo sync, no catalog apps
#   SAMURAI_PACMAN_CONF=<file>  offline repository config for pac()
#   SAMURAI_SERIAL_CONSOLE=1    VM harness: add console=ttyS0 to the cmdline
# Install-time facts (UUIDs, encryption flags, GPU, the user's password hash)
# are read from /var/lib/samurai/install-env (0600, written by the driver).
# What gets installed is decided by samurai-profile-plan, never here.
set -euo pipefail

PROFILE="${1:?usage: samurai-postinstall /path/to/profile.toml}"
[ -f "$PROFILE" ] || { echo "profile not found: $PROFILE" >&2; exit 1; }
INSTALL_ENV=/var/lib/samurai/install-env

log() { printf '%s %s\n' "$(date -Is)" "$*"; }
fatal() { log "FATAL: $1"; exit "${2:-1}"; }
# systemctl enable with the failure visible and fatal: a typo'd unit name used
# to disable snapshot cleanup silently (2026-11-22)
enable_unit() {
    local out
    if out=$(systemctl enable "$@" 2>&1); then
        log "service: $* enabled"
    else
        fatal "systemctl enable $* failed: $out" 18
    fi
}
# key=value reader for the install-env file (never sourced: a config file is
# data, not code)
env_get() { { grep -s "^$1=" "$INSTALL_ENV" || true; } | head -1 | cut -d= -f2-; }
# Offline installs: samurai-install binds the medium's local repository into
# the target and passes its pacman config here. Every install below goes
# through pac, so online and offline installs resolve the same package sets.
# samurai-install copies the toolbox into the target before this runs, so the
# first samurai-tools install meets those unowned files. pacman checks file
# conflicts BEFORE pre_install, so the package's cleanup hook cannot help:
# let it take over exactly the paths it ships (never anything else).
SAMURAI_OWNED_OVERWRITE=(
    --overwrite '/usr/local/bin/samurai'
    --overwrite '/usr/local/bin/samurai-*'
    --overwrite '/usr/share/samurai/catalog/*'
    --overwrite '/usr/lib/samurai/interventions/*'
)
# pac -S [options] -- packages : options first, then the package list after
# `--` so a package name can never be parsed as a pacman option
pac() {
    local op="${1:?}"; shift
    local extra=()
    [ "$op" = -S ] && extra=("${SAMURAI_OWNED_OVERWRITE[@]}")
    if [ -n "${SAMURAI_PACMAN_CONF:-}" ]; then
        pacman --config "$SAMURAI_PACMAN_CONF" "$op" "${extra[@]}" "$@"
    else
        pacman "$op" "${extra[@]}" "$@"
    fi
}
pac_install() { pac -S --noconfirm --needed -- "$@"; }
installed() { pacman -Q -- "$1" >/dev/null 2>&1; }
log "samurai-postinstall starting"

# Pull validated values in ONE read (strict regexes already passed, so no
# value contains whitespace or a newline; lists are space-joined). Fixed line
# order, documented here and in the python block.
{
    read -r HOSTNAME
    read -r TZ
    read -r LOCALE
    read -r KB
    read -r -a KERNEL_ARR
    read -r BLDR
    read -r UNAME
    read -r USHELL
    read -r ENCRYPT
    read -r AUTOKEY
    read -r DESKTOP
    read -r -a APPS
    read -r FW
    read -r SSHD
    read -r KDE_THEME
    read -r KDE_EFFECTS
    read -r KDE_WIDGETS
    read -r DOCKER_MODE
} < <(python3 - "$PROFILE" <<'PY'
import sys, tomllib
p = tomllib.loads(open(sys.argv[1], "rb").read().decode())
s, d, b, u = p.get("system", {}), p.get("disk", {}), p.get("boot", {}), p.get("user", {})
pk, sec = p.get("packages", {}), p.get("security", {})
print(s.get("hostname", "samurai"))
print(s.get("timezone", "UTC"))
print(s.get("locale", "en_US.UTF-8"))
print(s.get("keyboard", "us"))
print(" ".join(b.get("kernels", ["linux"])))
print(b.get("bootloader", "limine"))
print(u.get("name", "samurai"))
print(u.get("shell", "bash"))
print(int(d.get("encryption", True)))
print(int(d.get("auto_unlock_keyfile", False)))
print(pk.get("desktop", "kde"))
print(" ".join(pk.get("apps", [])))
print(sec.get("firewall", "none"))
print("yes" if sec.get("ssh_server", False) else "no")
k = p.get("kde", {})
print(k.get("theme", "breeze"))
print("reduced" if k.get("reduced_effects", True) else "default")
print("on" if k.get("monitor_widgets", True) else "off")
print(p.get("development", {}).get("docker", "none"))
PY
) || fatal "profile read failed"
[ -n "$HOSTNAME" ] && [ ${#KERNEL_ARR[@]} -gt 0 ] && [ -n "$UNAME" ] || fatal "profile read incomplete"
# the driver's facts win over the profile (it measured the real disk)
v=$(env_get SAMURAI_ENCRYPT); [ -n "$v" ] && ENCRYPT=$v
v=$(env_get SAMURAI_AUTOKEY); [ -n "$v" ] && AUTOKEY=$v
UPWHASH=$(env_get SAMURAI_PWHASH)
unset v
NVIDIA=$(env_get SAMURAI_NVIDIA)

### identity ###
log "identity: hostname=$HOSTNAME tz=$TZ locale=$LOCALE keymap=$KB"
printf '%s\n' "$HOSTNAME" > /etc/hostname
[ -f "/usr/share/zoneinfo/$TZ" ] || fatal "timezone file missing in the target: $TZ"
ln -sfn "/usr/share/zoneinfo/$TZ" /etc/localtime
# LOCALE matched ^[a-zA-Z]{2,3}(_[A-Za-z]{2,4})?\.[A-Za-z0-9-]+$ : the only
# regex-special character it can contain is '.', escaped here
sed -i "s|^#\(${LOCALE//./\\.} \)|\1|" /etc/locale.gen
grep -q "^${LOCALE//./\\.} " /etc/locale.gen || fatal "locale $LOCALE is not listed in /etc/locale.gen"
locale-gen
printf 'LANG=%s\n' "$LOCALE" > /etc/locale.conf
printf 'KEYMAP=%s\n' "$KB" > /etc/vconsole.conf
cat > /etc/hosts <<EOF
127.0.0.1	localhost
::1		localhost
127.0.1.1	$HOSTNAME.localdomain	$HOSTNAME
EOF

### [samurai] repo (spec 02, ADR-0007): key staged from the live ISO ###
log "repos: enabling [samurai]"
pacman-key --init
if [ -f /usr/share/samurai/build-key.txt ]; then
    pacman-key --add /usr/share/samurai/build-key.txt
    # pinned fingerprint: a swapped build-key.txt fails here (set -e)
    pacman-key --lsign-key DFE8C148C042AA3C199AAEA08436E12731EDD3FA
fi
# Appended at the END of pacman.conf: below core/extra/multilib/cachyos, so
# [samurai] can only add packages, never shadow an Arch one (spec 02 rule).
# Bootstrap server list = the mirrorlist file the installer staged from the
# ISO; once the samurai-mirrorlist package owns /etc/pacman.d/samurai-mirrorlist
# the Include is switched to it (one source for the Server lines).
SAMURAI_ML_BOOT=/usr/share/samurai/samurai-mirrorlist
SAMURAI_ML=/etc/pacman.d/samurai-mirrorlist
if ! grep -q '^\[samurai\]' /etc/pacman.conf; then
    [ -f "$SAMURAI_ML_BOOT" ] || fatal "missing $SAMURAI_ML_BOOT (staged by samurai-install)"
    printf '\n# Samurai OS repository (spec 02): signed packages AND database\n[samurai]\nSigLevel = Required DatabaseRequired\nInclude = %s\n' \
        "$SAMURAI_ML_BOOT" >> /etc/pacman.conf
fi
### [chaotic-aur] (ADR-0007): the keyring package carries the trust; the primary
### key is pinned, so a swapped keyring or mirror cannot slip in another signer
CHAOTIC_FPR=EF925EA60F33D0CB85C44AD13056513887B78AEB
log "repos: verifying [chaotic-aur] trust ($CHAOTIC_FPR)"
grep -q '^\[chaotic-aur\]' /etc/pacman.conf || fatal "pacman.conf has no [chaotic-aur] section" 11
[ -f /etc/pacman.d/chaotic-mirrorlist ] || fatal "chaotic-mirrorlist is not installed" 11
pacman-key --populate chaotic || fatal "cannot populate the chaotic keyring (chaotic-keyring missing?)" 11
# field 2 of the pub record is the computed validity: f = full (locally signed)
gpg --homedir /etc/pacman.d/gnupg --batch --with-colons --list-keys "$CHAOTIC_FPR" 2>/dev/null \
    | awk -F: '/^pub:/ {ok = ($2 == "f" || $2 == "u")} END {exit !ok}' \
    || fatal "the pinned Chaotic-AUR key $CHAOTIC_FPR is missing or not trusted" 11

if [ "${SAMURAI_OFFLINE:-0}" = 1 ]; then
    log "repos: offline install — no repo sync in the target"
else
    pacman -Syy
fi

### one transaction with everything the profile selects (spec 08 step 6) ###
PLAN_ARGS=()
[ "${SAMURAI_OFFLINE:-0}" = 1 ] && PLAN_ARGS+=(--offline)
[ "$NVIDIA" = 1 ] && PLAN_ARGS+=(--nvidia)
# CUDA (spec 07): a Turing or newer chip among the NVIDIA display controllers
if lspci -mm -nn 2>/dev/null | awk -F'"' '$2 ~ /\[03/ && $4 ~ /\[10de\]/ && $6 ~ /^(TU|GA|AD|GH|GB)[0-9]/ {f=1} END{exit !f}'; then
    PLAN_ARGS+=(--cuda-gpu)
fi
# PCI class 03xx display controller, vendor 1002 = AMD
if lspci -mm -n 2>/dev/null | awk '{gsub(/"/,"")} $2 ~ /^03/ && $3=="1002"{f=1} END{exit !f}'; then
    PLAN_ARGS+=(--amd)
fi
PLAN=$(samurai-profile-plan "$PROFILE" "${PLAN_ARGS[@]}") || fatal "cannot plan the package set" 12
plan_get() { sed -n "s/^$1 //p" <<<"$PLAN"; }
mapfile -t PLAN_PKGS < <(plan_get pkg)
mapfile -t PLAN_SERVICES < <(plan_get service)
mapfile -t PLAN_USER_SERVICES < <(plan_get user-service)
mapfile -t PLAN_GROUPS < <(plan_get group)
mapfile -t PLAN_DEFERRED < <(plan_get defer)
while IFS= read -r note; do
    [ -n "$note" ] && log "note: $note"
done < <(plan_get note)
[ "${#PLAN_PKGS[@]}" -gt 0 ] || fatal "the package plan is empty" 12
log "packages: ${#PLAN_PKGS[@]} selected: ${PLAN_PKGS[*]}"
pac_install "${PLAN_PKGS[@]}" || fatal "package installation failed" 16

if [ -f "$SAMURAI_ML" ] && grep -q "^Include = $SAMURAI_ML_BOOT\$" /etc/pacman.conf; then
    sed -i "s|^Include = $SAMURAI_ML_BOOT\$|Include = $SAMURAI_ML|" /etc/pacman.conf
    log "repos: [samurai] now uses $SAMURAI_ML (samurai-mirrorlist package)"
fi

FIRSTBOOT_NOTES=/var/lib/samurai/firstboot-notes
note() { mkdir -p /var/lib/samurai; printf '%s   # %s\n' "$1" "$2" >> "$FIRSTBOOT_NOTES"; }
for line in "${PLAN_DEFERRED[@]}"; do
    [ -n "$line" ] || continue
    log "deferred to first boot: ${line%%$'\t'*} (${line#*$'\t'})"
    note "${line%%$'\t'*}" "${line#*$'\t'}"
done

### desktop (spec 14: files and defaults come from samurai-settings-kde) ###
log "desktop: $DESKTOP"
# The login screen and the desktop follow the chosen keyboard too (vconsole.conf
# only covers the console): without this a password typed in another layout at
# install time cannot be typed at the first login.
if [ "$DESKTOP" != none ]; then
    XKB_LAYOUT=""; XKB_VARIANT=""
    read -r XKB_LAYOUT XKB_VARIANT < <(awk -v k="$KB" '$1==k {print $2, $4; exit}' \
        /usr/share/systemd/kbd-model-map 2>/dev/null) || true
    # names the table does not list ("pl") match an XKB layout of the same name
    [ -n "$XKB_LAYOUT" ] || [ ! -f "/usr/share/X11/xkb/symbols/$KB" ] || XKB_LAYOUT=$KB
    [ "$XKB_VARIANT" != - ] || XKB_VARIANT=""
    if [ -n "$XKB_LAYOUT" ]; then
        install -d -m 755 /etc/X11/xorg.conf.d /etc/xdg
        printf 'Section "InputClass"\n    Identifier "system-keyboard"\n    MatchIsKeyboard "on"\n    Option "XkbLayout" "%s"\n    Option "XkbVariant" "%s"\nEndSection\n' \
            "$XKB_LAYOUT" "$XKB_VARIANT" > /etc/X11/xorg.conf.d/00-keyboard.conf
        printf '[Layout]\nLayoutList=%s\nVariantList=%s\nUse=true\n' \
            "$XKB_LAYOUT" "$XKB_VARIANT" > /etc/xdg/kxkbrc
        chmod 644 /etc/X11/xorg.conf.d/00-keyboard.conf /etc/xdg/kxkbrc
        log "keyboard: graphical layout $XKB_LAYOUT ${XKB_VARIANT}"
    else
        log "WARNING: keyboard: no graphical layout known for keymap $KB (login screen stays us)"
    fi
fi
if [ "$DESKTOP" = kde ]; then
    samurai-kde-defaults apply --theme "$KDE_THEME" --effects "$KDE_EFFECTS" --widgets "$KDE_WIDGETS" \
        || fatal "cannot apply the KDE defaults" 16
fi
for unit in "${PLAN_SERVICES[@]}"; do
    [ -n "$unit" ] || continue
    enable_unit "$unit"
done

### firewall (spec 09, ADR-0006: firewalld default; deny inbound except DHCPv6) ###
case "$FW" in
    firewalld|ufw)
        if [ "$FW" = firewalld ]; then
            # Offline config: firewall-offline-cmd works without the daemon
            # (chroot) and writes /etc/firewalld/zones/public.xml.
            # SYNTAX MATTERS: with --zone, removing a service is
            # --remove-service-from-zone=NAME; plain --remove-service= is a
            # lokkit compatibility option that firewall-offline-cmd rejects
            # ("Can't use lokkit options with other options", rc 2) — this
            # left ssh open in zone public on every install until 2026-11-22.
            # Only the documented no-op codes are tolerated: 16 ZONE_ALREADY_SET,
            # 11 ALREADY_ENABLED, 12 NOT_ENABLED.
            fwo() {
                local out rc=0
                out=$(firewall-offline-cmd "$@" 2>&1) || rc=$?
                case "$rc" in 0|11|12|16) ;; *) fatal "firewall-offline-cmd $* failed (rc=$rc): $out" 17 ;; esac
            }
            fwo --set-default-zone=public
            for svc in $(firewall-offline-cmd --zone=public --list-services); do
                [ "$svc" = dhcpv6-client ] || fwo --zone=public --remove-service-from-zone="$svc"
            done
            fwo --zone=public --add-service=dhcpv6-client
            [ "$SSHD" = yes ] && fwo --zone=public --add-service=ssh
            # the RESULT is checked, exactly: default zone public, and its
            # service list is {dhcpv6-client} (+ ssh only when the profile asked)
            FW_ZONE=$(firewall-offline-cmd --get-default-zone)
            FW_SVCS=$(firewall-offline-cmd --zone=public --list-services | tr ' ' '\n' | sort | tr '\n' ' ')
            FW_WANT="dhcpv6-client "
            [ "$SSHD" = yes ] && FW_WANT="dhcpv6-client ssh "
            [ "$FW_ZONE" = public ] || fatal "firewalld default zone is $FW_ZONE" 17
            [ "$FW_SVCS" = "$FW_WANT" ] || fatal "firewalld zone public allows '$FW_SVCS', wanted '$FW_WANT'" 17
            [ -f /etc/firewalld/zones/public.xml ] || fatal "firewalld wrote no /etc/firewalld/zones/public.xml" 17
            enable_unit firewalld.service
            log "firewall: firewalld, zone public: $FW_SVCS"
        else
            # ufw's CLI mostly edits /etc/default/ufw and /etc/ufw/user.rules; in
            # the chroot it may complain about the missing daemon, so the RESULT
            # on disk is what gets checked, not the command status
            ufw default deny incoming 2>&1 || log "ufw default deny incoming: nonzero (checking config)"
            ufw default allow outgoing 2>&1 || log "ufw default allow outgoing: nonzero (checking config)"
            if [ "$SSHD" = yes ]; then
                ufw allow ssh 2>&1 || log "ufw allow ssh: nonzero (checking config)"
                grep -q -- '--dport 22 ' /etc/ufw/user.rules || fatal "ufw: ssh rule missing in user.rules" 17
            fi
            sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
            grep -q '^ENABLED=yes' /etc/ufw/ufw.conf || fatal "ufw.conf not enabled" 17
            grep -q '^DEFAULT_INPUT_POLICY="DROP"' /etc/default/ufw || fatal "ufw: input policy is not DROP" 17
            grep -q '^DEFAULT_OUTPUT_POLICY="ACCEPT"' /etc/default/ufw || fatal "ufw: output policy is not ACCEPT" 17
            enable_unit ufw.service
            log "firewall: ufw (deny incoming)"
        fi
        ;;
    none) log "firewall: none (profile choice)" ;;
    *) fatal "unsupported firewall: $FW" 17 ;;
esac
if [ "$SSHD" = yes ]; then
    # spec 09: key-only, no root. Root is locked anyway; passwords stay
    # off so a fresh box is never brute-forceable before keys are placed
    # (add them in ~/.ssh/authorized_keys from the console).
    install -d -m 755 /etc/ssh/sshd_config.d
    cat > /etc/ssh/sshd_config.d/10-samurai.conf <<'EOF'
# Samurai OS (spec 09): key-only, no root login
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
MaxAuthTries 3
EOF
    enable_unit sshd.service
    log "ssh: sshd enabled (key-only; add authorized_keys before relying on it)"
fi

# networking is a basic function (spec 09): NetworkManager always on when
# the package is present (the baked offline set carries it)
if installed networkmanager; then
    enable_unit NetworkManager.service
fi

### brand the installed system (spec 14: welcome, not raw instructions) ###
cat > /etc/motd <<'EOF'
Welcome home, ronin — this is your Samurai OS.

Your blade is the `samurai` command:
  samurai update       refresh the system — a snapshot is taken first, always
  samurai snap         capture this moment before you act
  samurai rescue       for when the path darkens
  samurai apps         find and install optional apps (samurai apps bundles)
  samurai health       check the blade for nicks, and mend them
EOF
cat > /etc/issue <<'EOF'
Samurai OS \s \m (\l)

The blade awaits. Login:
EOF

### optional apps from the catalog (profile [packages] apps; spec 08 step 6) ###
# Same resolver as `samurai apps install` on the running system. Online only:
# offline installs (and anything skipped) leave a first-boot note instead, so
# the user can run the exact command later. App failures never fail the
# install: the base system is already complete at this point.
if [ "${#APPS[@]}" -gt 0 ]; then
    mkdir -p /var/lib/samurai
    APPS_CMD="samurai apps install ${APPS[*]}"
    APPS_DONE=0
    if [ "${SAMURAI_OFFLINE:-0}" = 1 ]; then
        log "apps: offline install — skipping catalog apps (${APPS[*]}); first-boot note written"
        printf '%s   # offline install: run once online (after samurai update)\n' "$APPS_CMD" >> "$FIRSTBOOT_NOTES"
    elif [ ! -x /usr/local/bin/samurai-apps ]; then
        log "WARNING: apps: samurai-apps missing in the target (samurai-tools too old); skipping ${APPS[*]}"
        printf '%s   # samurai-apps was not installed during setup\n' "$APPS_CMD" >> "$FIRSTBOOT_NOTES"
    else
        log "apps: installing ${APPS[*]}"
        # --with-upgrade: pacman -Su in the same transaction (the target was just
        # synced, never a partial upgrade); --ignore-db-age: a pinned archive
        # mirror has old-but-correct databases; vendor scripts wait for first boot
        if SAMURAI_CHROOT=1 SAMURAI_APPS_NOTES_FILE="$FIRSTBOOT_NOTES" /usr/local/bin/samurai-apps \
                install --yes --with-upgrade --ignore-db-age --skip-unavailable --no-user-scripts \
                -- "${APPS[@]}" 2>&1; then
            log "apps: done"
            APPS_DONE=1
        else
            rc=$?
            log "WARNING: apps: samurai-apps install failed (rc=$rc); first-boot note written"
            printf '%s   # failed during install (rc=%s), see /var/log/samurai/install.log\n' \
                "$APPS_CMD" "$rc" >> "$FIRSTBOOT_NOTES"
        fi
    fi
    if [ "$APPS_DONE" -eq 1 ]; then log "apps: installed"; fi
fi
if [ -s "$FIRSTBOOT_NOTES" ]; then
    {
        printf '\nStill to do from your install profile (%s):\n' "$FIRSTBOOT_NOTES"
        sed 's/^/  /' "$FIRSTBOOT_NOTES"
    } >> /etc/motd
    log "first-boot notes: $(tr '\n' ';' < "$FIRSTBOOT_NOTES")"
fi

### users ###
if ! id -u -- "$UNAME" >/dev/null 2>&1; then
    useradd -m -G wheel -s "/bin/$USHELL" -- "$UNAME"
    if [ -n "$UPWHASH" ]; then
        # crypt hash from the profile (unattended installs): fed to chpasswd -e
        # on stdin — never on a command line (visible in /proc/*/cmdline)
        printf '%s:%s\n' "$UNAME" "$UPWHASH" | chpasswd -e
        log "user $UNAME created (password from profile hash)"
    else
        # interactive installs without a hash: a generated password lands at
        # 0600 in /root; plaintext passwords are FORBIDDEN in profiles
        # no open-ended producer in the pipe: tr would die of SIGPIPE under pipefail
        UPASS="$(head -c 96 /dev/urandom | base64 -w0 | tr -dc 'A-Za-z0-9' | head -c 24)"
        [ ${#UPASS} -eq 24 ] || fatal "password generation failed"
        printf '%s:%s\n' "$UNAME" "$UPASS" | chpasswd
        ( umask 077; printf '%s : %s\n' "$UNAME" "$UPASS" > /root/initial-credentials )
        unset UPASS
        log "user $UNAME created (initial password in /root/initial-credentials, 0600)"
    fi
fi
unset UPWHASH

### groups and per-user services chosen by the profile ###
for group in "${PLAN_GROUPS[@]}"; do
    [ -n "$group" ] || continue
    getent group "$group" >/dev/null || fatal "group $group does not exist (package missing?)" 20
    usermod -aG "$group" -- "$UNAME" || fatal "cannot add $UNAME to $group" 20
    log "user: $UNAME added to group $group"
done
# user units are enabled by symlink: there is no user systemd inside the chroot
UHOME=$(getent passwd "$UNAME" | cut -d: -f6)
[ -d "$UHOME" ] || fatal "home directory of $UNAME is missing" 20
for unit in "${PLAN_USER_SERVICES[@]}"; do
    [ -n "$unit" ] || continue
    [ -f "/usr/lib/systemd/user/$unit" ] || fatal "user unit $unit does not exist" 20
    case "$unit" in *.socket) want=sockets.target.wants ;; *) want=default.target.wants ;; esac
    # as the user: nothing in the home can redirect a root write
    runuser -u "$UNAME" -- sh -c 'mkdir -p "$1" && ln -sfn "$2" "$1/${2##*/}"' sh \
        "$UHOME/.config/systemd/user/$want" "/usr/lib/systemd/user/$unit" \
        || fatal "cannot enable user unit $unit" 20
    log "user service: $unit enabled for $UNAME"
done
if [ "$DOCKER_MODE" = rootless ] && installed docker-rootless-extras; then
    grep -q "^$UNAME:" /etc/subuid && grep -q "^$UNAME:" /etc/subgid \
        || fatal "rootless Docker needs subordinate uid/gid ranges for $UNAME" 20
fi
# containers get the GPU (spec 13); rootful daemon configuration only
if [ "$DOCKER_MODE" = group ] && [ "$NVIDIA" = 1 ] && command -v nvidia-ctk >/dev/null; then
    nvidia-ctk runtime configure --runtime=docker || fatal "nvidia-ctk configuration failed" 20
fi
# the hash has served its purpose: it stays on no file of the installed system
[ -f "$INSTALL_ENV" ] && sed -i '/^SAMURAI_PWHASH=/d' "$INSTALL_ENV"
passwd -l root || fatal "could not lock root"

# wheel sudo, verified before activation (spec 09: timestamp_timeout=5)
( umask 027; cat > /etc/sudoers.d/10-wheel <<'EOF'
Defaults timestamp_timeout=5
%wheel ALL=(ALL:ALL) ALL
EOF
)
chmod 440 /etc/sudoers.d/10-wheel
visudo -c -q || { rm -f /etc/sudoers.d/10-wheel; fatal "sudoers check failed"; }

### mkinitcpio (hooks are written pre-pacstrap by the driver) ###
# The kernel packages' hooks already built the images with our conf; this
# rebuild is the explicit, fail-closed one the boot entries depend on.
for k in "${KERNEL_ARR[@]}"; do
    log "mkinitcpio for $k"
    mkinitcpio --preset "$k" 2>&1 || fatal "mkinitcpio failed for $k" 19
done

ROOT_UUID="$(env_get SAMURAI_ROOT_UUID)"
LUKS_UUID="$(env_get SAMURAI_LUKS_UUID)"
ESP_UUID="$(env_get SAMURAI_ESP_UUID)"
[ -n "$ROOT_UUID" ] || fatal "no SAMURAI_ROOT_UUID in $INSTALL_ENV (written by samurai-install)" 14
log "disk facts: root=$ROOT_UUID esp=$ESP_UUID luks=${LUKS_UUID:-none} encrypt=$ENCRYPT autokey=$AUTOKEY"
[ "$ENCRYPT" -eq 0 ] || [ -n "$LUKS_UUID" ] || fatal "encrypted install without SAMURAI_LUKS_UUID" 14
# One kernel command line for every bootloader (same rd.luks / keyfile
# contract, spec 08). The serial console is a VM-harness affordance: on real
# hardware the last console= would make /dev/console a non-existent port and
# hide every boot message.
kernel_cmdline() {
    local opts="root=UUID=$ROOT_UUID rw rootflags=subvol=@"
    if [ "$ENCRYPT" -eq 1 ]; then
        opts="$opts rd.luks.uuid=$LUKS_UUID rd.luks.options=$LUKS_UUID=discard"
        if [ "$AUTOKEY" -eq 1 ]; then
            # keyfile is EMBEDDED in the initramfs (mkinitcpio FILES=()) — no
            # keydev mount needed during unlock
            opts="$opts rd.luks.key=/etc/cryptsetup-keys.d/samurai-root.key"
        fi
    fi
    # spec 09: AppArmor is compiled into the Arch/CachyOS kernels but only active
    # when it is named in lsm= (the list replaces the kernel's built-in one)
    if installed samurai-settings-security; then
        opts="$opts lsm=landlock,lockdown,yama,integrity,apparmor,bpf"
    fi
    if [ "$AUTOKEY" -eq 1 ] || [ "${SAMURAI_SERIAL_CONSOLE:-0}" = 1 ]; then
        opts="$opts console=tty1 console=ttyS0,115200"
    fi
    printf '%s' "$opts"
}
KOPTS=$(kernel_cmdline)
log "kernel cmdline: $KOPTS"
# no /etc/crypttab: the initramfs unlock (rd.luks.uuid + embedded keyfile)
# names the mapper luks-<uuid> and the fstab addresses everything by UUID —
# a crypttab re-open of the same device just produces a failed unit.
case "$BLDR" in
limine)
    log "bootloader: Limine (ADR-0003)"
    # UEFI install via the firmware fallback path; the config lives next to
    # the binary. boot(): inside the config refers to the ESP.
    install -d /boot/EFI/BOOT /boot/limine
    install -m644 /usr/share/limine/BOOTX64.EFI /boot/EFI/BOOT/BOOTX64.EFI
    {
        printf 'timeout: 3\n\n'
        printf '# Samurai OS boot entries (managed by samurai; snapshot\n'
        printf '# entries are added/removed by the snapshot boot sync)\n'
        for k in "${KERNEL_ARR[@]}"; do
            printf '/Samurai OS (%s)\n' "$k"
            printf '    protocol: linux\n'
            printf '    path: boot():/vmlinuz-%s\n' "$k"
            printf '    cmdline: %s\n' "$KOPTS"
            printf '    module_path: boot():/initramfs-%s.img\n' "$k"
            printf '\n'
        done
        for k in "${KERNEL_ARR[@]}"; do
            [ -s "/boot/initramfs-$k-fallback.img" ] || continue  # preset without a fallback image (linux-cachyos)
            printf '/Samurai OS (%s, fallback initramfs)\n' "$k"
            printf '    protocol: linux\n'
            printf '    path: boot():/vmlinuz-%s\n' "$k"
            printf '    cmdline: %s\n' "$KOPTS"
            printf '    module_path: boot():/initramfs-%s-fallback.img\n' "$k"
            printf '\n'
        done
    } > /boot/limine/limine.conf
    log "limine.conf: $(tr '\n' ' ' < /boot/limine/limine.conf)"
    ;;
grub)
    log "bootloader: GRUB (user-selected)"
    # ESP is mounted at /boot; kernel cmdline matches the Limine branch so the
    # rescue/rollback path (rd.luks, embedded keyfile) behaves identically.
    sed -i "s|^GRUB_CMDLINE_LINUX=.*|GRUB_CMDLINE_LINUX=\"$KOPTS\"|" /etc/default/grub
    sed -i 's|^GRUB_TIMEOUT=.*|GRUB_TIMEOUT=3|' /etc/default/grub
    grub-install --target=x86_64-efi --efi-directory=/boot \
        --bootloader-id=SamuraiOS --recheck 2>&1 || fatal "grub-install failed" 14
    grub-mkconfig -o /boot/grub/grub.cfg 2>&1 | tail -3
    log "grub.cfg written ($(grep -c menuentry /boot/grub/grub.cfg 2>/dev/null || echo '?') entries)"
    ;;
systemd-boot)
    log "bootloader: systemd-boot (user-selected)"
    # kernel-install/bootctl: hand-written entries, same cmdline contract
    bootctl install --esp-path=/boot --no-variables 2>&1 || fatal "bootctl install failed" 14
    printf 'timeout 3\ndefault @saved\n' > /boot/loader/loader.conf
    install -d /boot/loader/entries
    for k in "${KERNEL_ARR[@]}"; do
        {
            printf 'title   Samurai OS (%s)\n' "$k"
            printf 'linux   /vmlinuz-%s\n' "$k"
            printf 'initrd  /initramfs-%s.img\n' "$k"
            printf 'options %s\n' "$KOPTS"
        } > "/boot/loader/entries/samurai-$k.conf"
        [ -s "/boot/initramfs-$k-fallback.img" ] || continue  # preset without a fallback image (linux-cachyos)
        {
            printf 'title   Samurai OS (%s, fallback initramfs)\n' "$k"
            printf 'linux   /vmlinuz-%s\n' "$k"
            printf 'initrd  /initramfs-%s-fallback.img\n' "$k"
            printf 'options %s\n' "$KOPTS"
        } > "/boot/loader/entries/samurai-$k-fallback.conf"
    done
    log "systemd-boot entries: $(ls /boot/loader/entries/)"
    ;;
refind)
    log "bootloader: rEFInd (user-selected)"
    # refind-install in chroot targets the ESP at /boot; kernel autodetect
    # plus our refind_linux.conf carrying the same cmdline contract
    refind-install --yes 2>&1 || fatal "refind-install failed" 14
    printf '%s\n%s\n%s\n' \
        "\"Boot Samurai OS\" \"$KOPTS\"" \
        "\"Boot Samurai OS (fallback)\" \"$KOPTS nomodeset\"" \
        "\"Boot to EFI shell\" \"\"" > /boot/refind_linux.conf
    log "refind_linux.conf: $(tr '\n' ' ' < /boot/refind_linux.conf)"
    ;;
*)
    fatal "bootloader $BLDR is not supported (Limine is the one per ADR-0003)" 14
    ;;
esac
log "fstab: $(tr '\n' ' ' < /etc/fstab)"

### services ###
log "services"
# the guest agent gives the hypervisor root exec: wanted on VMs only (the
# package stays in the profile list so a cloned image works under KVM)
if installed qemu-guest-agent && systemd-detect-virt -q; then
    enable_unit qemu-guest-agent.service
fi
# one network manager: NetworkManager on desktops, systemd-networkd otherwise
# (both enabled race for the same interfaces)
if installed networkmanager; then
    enable_unit systemd-resolved.service
else
    # network config lives on the ISO, not in the pacstrap'd target (learned:
    # the updater's preflight died on "no network"). Basic DHCP for networkd:
    install -d -m 755 /etc/systemd/network
    printf '[Match]\nName=en* eth* wl*\n\n[Network]\nDHCP=yes\n' > /etc/systemd/network/20-samurai.network
    enable_unit systemd-networkd.service systemd-resolved.service
fi
# resolved stub for DNS (only if absent: other resolvers may own this path)
[ -e /etc/resolv.conf ] || ln -s /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
# time sync (NTP)
enable_unit systemd-timesyncd.service

### snapshots (spec 06): snapper + snap-pac + maintenance timers ###
log "snapshots: snapper root config + snap-pac"
# @snapshots is pre-mounted at /.snapshots by the driver (spec 06 layout: it
# must survive root-subvol replacement).
if [ "${SAMURAI_CHROOT:-0}" != 1 ]; then
    # real system (toolbox-driven re-run): "/" is the @ mountpoint and the
    # snapper daemon owns the system — swap @snapshots out, create-config,
    # delete the subvol it makes, remount ours (fstab is authoritative).
    SWAP_SNAPSHOTS=0
    if mountpoint -q /.snapshots; then
        log "snapshots: /.snapshots pre-mounted (@snapshots) — swapping out for create-config"
        umount /.snapshots || fatal "cannot unmount /.snapshots" 15
        rmdir /.snapshots
        SWAP_SNAPSHOTS=1
    fi
    if ! snapper -c root create-config / 2>&1; then
        fatal "snapper create-config failed — no rollback support" 15
    fi
    if [ "$SWAP_SNAPSHOTS" -eq 1 ]; then
        btrfs subvolume delete /.snapshots 2>&1 || log "WARNING: could not delete snapper's own /.snapshots subvolume"
        mkdir -p /.snapshots
        mount /.snapshots || fatal "remount of @snapshots failed" 15
    fi
    snapper -c root set-config 'TIMELINE_CREATE="no"' \
        'NUMBER_LIMIT="20"' 'NUMBER_LIMIT_IMPORTANT="10"' \
        'EMPTY_PRE_POST_CLEANUP="yes"' || log "WARNING: snapper set-config failed"
else
    # chroot (install): NEVER use `snapper create-config` here. Three layers
    # of failure observed 2026-11-18: (1) "/" is not a mountpoint in the
    # kernel's view inside a chroot; (2) --root + --no-dbus still detects the
    # live env's overlay fstype and refuses; (3) even with the right
    # mountpoint passed, the CLI stores configs in the LIVE /etc, not the
    # target. A snapper config is a plain key-value file: write it from the
    # shipped template. @snapshots stays mounted — no swap.
    if [ ! -f /etc/snapper/configs/root ]; then
        log "snapshots: writing root config from template (chroot-safe)"
        install -d -m 755 /etc/snapper/configs
        sed -e 's|^FSTYPE=.*|FSTYPE="btrfs"|' \
            -e 's|^SUBVOLUME=.*|SUBVOLUME="/"|' \
            -e 's|^TIMELINE_CREATE=.*|TIMELINE_CREATE="no"|' \
            -e 's|^NUMBER_LIMIT=.*|NUMBER_LIMIT="20"|' \
            -e 's|^NUMBER_LIMIT_IMPORTANT=.*|NUMBER_LIMIT_IMPORTANT="10"|' \
            -e 's|^EMPTY_PRE_POST_CLEANUP=.*|EMPTY_PRE_POST_CLEANUP="yes"|' \
            /usr/share/snapper/config-templates/default > /etc/snapper/configs/root \
            || fatal "cannot write snapper root config" 15
    fi
    [ -d /.snapshots ] || mkdir -p /.snapshots
    mountpoint -q /.snapshots \
        || log "WARNING: /.snapshots not mounted in-chroot (fstab mounts @snapshots at boot)"
fi
# `snapper create-config` registers the config in /etc/conf.d/snapper; the
# template path above does not, and without SNAPPER_CONFIGS="root" every
# `snapper -c root ...` says "config does not exist" (samurai update exit 11)
install -d -m 755 /etc/conf.d
if grep -qs '^SNAPPER_CONFIGS=' /etc/conf.d/snapper; then
    grep -q '^SNAPPER_CONFIGS=.*\broot\b' /etc/conf.d/snapper \
        || sed -i 's|^SNAPPER_CONFIGS="\(.*\)"|SNAPPER_CONFIGS="\1 root"|; s|^SNAPPER_CONFIGS=" |SNAPPER_CONFIGS="|' /etc/conf.d/snapper
else
    printf 'SNAPPER_CONFIGS="root"\n' >> /etc/conf.d/snapper
fi
grep -q '^SNAPPER_CONFIGS=.*\broot\b' /etc/conf.d/snapper || fatal "could not register the snapper root config" 15
# snap-pac 3.x: pre/post snapshots around every pacman transaction. Snapshots
# touching the packages below carry userdata important=yes, which is what
# NUMBER_LIMIT_IMPORTANT keys on (spec 06). Key names per snap-pac(8) and
# /etc/snap-pac.ini as shipped by the package (lists are JSON).
rm -f /etc/pacman.d/hooks/10-samurai-important-snap.hook   # replaced: it was unparseable by pacman
cat > /etc/snap-pac.ini <<'EOF'
# Samurai OS snap-pac configuration (written by samurai-postinstall; snap-pac(8))
[root]
snapshot = True
cleanup_algorithm = number
important_packages = ["linux", "linux-lts", "linux-zen", "linux-cachyos", "linux-cachyos-lts", "systemd", "glibc", "limine", "grub", "refind", "btrfs-progs", "snapper", "cryptsetup", "mkinitcpio"]
important_commands = ["pacman -Syu", "pacman -Syyu"]
EOF
enable_unit snapper-cleanup.timer
enable_unit fstrim.timer
# spec 06: monthly btrfs scrub of the root filesystem (`-` is systemd's escaped path for /);
# `samurai health` (storage.btrfs-timers) reports and repairs it when it is off
enable_unit 'btrfs-scrub@-.timer'
# pacman cache hygiene (pacman-contrib also provides checkupdates for the notifier)
enable_unit paccache.timer
### fingerprint + install info ###
install -d -m 755 /var/lib/samurai
# spec 07: the baseline `samurai hw fingerprint --check` compares with at every boot (a plain
# listing it replaces on first boot is left when this cannot run)
if samurai hw fingerprint --accept; then
    log "hardware: fingerprint recorded"
else
    { lspci -nn 2>/dev/null || true; } | sed 's/^/  /' > /var/lib/samurai/hw-fingerprint
fi
chmod 644 /var/lib/samurai/hw-fingerprint
if [ ! -f /var/lib/samurai/install-profile.toml ]; then
    # manual run (the driver stages a hash-free copy at 0600 itself)
    ( umask 077; grep -v '^password_hash = ' "$PROFILE" > /var/lib/samurai/install-profile.toml )
fi
chmod 600 /var/lib/samurai/install-profile.toml
python3 - <<'PY' > /var/lib/samurai/install-info.json
import json, os, platform, time
print(json.dumps({"version": 1, "arch": platform.machine(),
                  "completed": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                  "builder": "samurai-postinstall M2"}, indent=1))
PY

log "samurai-postinstall complete"
