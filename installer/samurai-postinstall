#!/usr/bin/env bash
# samurai-postinstall — applies a validated install profile inside the target
# chroot (spec 08). Idempotent-ish, every step logged to /var/log/samurai/install.log
# (and it inherits the driver's tee when driven by samurai-install).
#
# Security posture: profile is validated BEFORE we get here (the driver calls
# validate-profile.py); values are never shell-interpolated beyond quoting;
# sudoers is checked with visudo -c; root is locked unless root_locked=false.
set -euo pipefail

PROFILE="${1:?usage: samurai-postinstall /path/to/profile.toml}"
[ -f "$PROFILE" ] || { echo "profile not found: $PROFILE" >&2; exit 1; }

log() { printf '%s %s\n' "$(date -Is)" "$*"; }
log "samurai-postinstall starting"

read -r HOSTNAME TZ LOCALE KB \
    < <(python3 - "$PROFILE" <<'PY'
import sys, tomllib
p = tomllib.loads(open(sys.argv[1]).read())
s = p.get("system", {})
print(s.get("hostname", "samurai"), s.get("timezone", "UTC"),
      s.get("locale", "en_US.UTF-8"), s.get("keyboard", "us"))
PY
) || exit 1
# kernels word-split into an array: a multi-kernel default (cachyos+zen)
# shifted every later field in the combined read ("unsupported bootloader:
# bash limine" — same bug class as the pacstrap target quoting)
read -r -a KERNEL_ARR \
    < <(python3 - "$PROFILE" <<'PY'
import sys, tomllib
p = tomllib.loads(open(sys.argv[1]).read())
print(" ".join(p.get("boot", {}).get("kernels", ["linux"])))
PY
) || exit 1
read -r BLDR \
    < <(python3 - "$PROFILE" <<'PY'
import sys, tomllib
p = tomllib.loads(open(sys.argv[1]).read())
print(p.get("boot", {}).get("bootloader", "limine"))
PY
) || exit 1
KERNELS="${KERNEL_ARR[*]}"
read -r UNAME USHELL UPWHASH < <(python3 - "$PROFILE" <<'PY'
import sys, tomllib
p = tomllib.loads(open(sys.argv[1]).read())
u = p.get("user", {})
print(u.get("name", "samurai"), u.get("shell", "bash"), u.get("password_hash", ""))
PY
) || exit 1
read -r ENCRYPT AUTOKEY < <(python3 - "$PROFILE" <<'PY'
import sys, tomllib
p = tomllib.loads(open(sys.argv[1]).read())
d = p.get("disk", {})
print(int(bool(d.get("encryption", True))), int(bool(d.get("auto_unlock_keyfile", False))))
PY
) || exit 1
read -r -a PACKAGES < <(python3 - "$PROFILE" <<'PY'
import sys, tomllib
p = tomllib.loads(open(sys.argv[1]).read())
print(" ".join(p.get("packages", {}).get("install", [])))
PY
) || exit 1
read -r DESKTOP < <(python3 - "$PROFILE" <<'PY'
import sys, tomllib
p = tomllib.loads(open(sys.argv[1]).read())
print(p.get("packages", {}).get("desktop", "kde"))
PY
) || exit 1

### identity ###
log "identity: hostname=$HOSTNAME tz=$TZ locale=$LOCALE"
echo "$HOSTNAME" > /etc/hostname
ln -sfn "/usr/share/zoneinfo/$TZ" /etc/localtime
sed -i "s|^#\(${LOCALE//./\\.}\)|\1|" /etc/locale.gen
grep -q "^$LOCALE" /etc/locale.gen || echo "$LOCALE UTF-8" >> /etc/locale.gen
locale-gen
echo "LANG=$LOCALE" > /etc/locale.conf
printf 'KEYMAP=%s\n' "$KB" > /etc/vconsole.conf
cat > /etc/hosts <<EOF
127.0.0.1	localhost
::1		localhost
127.0.1.1	$HOSTNAME.localdomain	$HOSTNAME
EOF

### [samurai] repo (spec 02): key staged from the live ISO ###
# NOTE: the mirrorlist is NOT pre-placed — the samurai-mirrorlist package owns
# /etc/pacman.d/samurai-mirrorlist and a pre-placed file breaks its install.
# The bootstrap repo section carries inline Server lines instead.
log "repos: enabling [samurai]"
pacman-key --init
if [ -f /usr/share/samurai/build-key.txt ]; then
    pacman-key --add /usr/share/samurai/build-key.txt
    pacman-key --lsign-key DFE8C148C042AA3C199AAEA08436E12731EDD3FA
fi
# [samurai] may already be present (offline -U copies the live medium's
# conf, which bakes the section): idempotent insert
if ! grep -q '^\[samurai\]' /etc/pacman.conf; then
sed -i '/^\[core\]/i [samurai]\
Server = https://github.com/GenorTG/samurai-repo/releases/download/x86_64\
Server = https://repo.smart-samurai.pl/samurai/x86_64\
SigLevel = Required DatabaseRequired' /etc/pacman.conf
fi
if [ "${SAMURAI_OFFLINE:-0}" = 1 ]; then
    log "repos: offline install — no repo sync in the target"
else
    pacman -Syy
fi

if [ "${#PACKAGES[@]}" -gt 0 ]; then
    # offline -U installs already covered these; only fetch what is missing
    MISSING=()
    for p in "${PACKAGES[@]}"; do
        pacman -Q "$p" >/dev/null 2>&1 || MISSING+=("$p")
    done
    if [ "${#MISSING[@]}" -gt 0 ]; then
        log "installing missing [samurai] packages: ${MISSING[*]}"
        pacman -S --noconfirm --needed "${MISSING[@]}"
    else
        log "[samurai] packages already present (offline cache path)"
    fi
fi

### desktop (spec 08: KDE Plasma default; alternatives opt-in) ###
DM=""
case "$DESKTOP" in
    kde)
        log "desktop: KDE Plasma (Breeze Dark)"
        pacman -S --noconfirm --needed plasma-meta plasma-wayland-session sddm konsole dolphin \
            kwrite ark gwenview okular || { log "FATAL: KDE install failed"; exit 16; }
        DM=sddm
        # Breeze Dark default for every new user (Genor 2026-11-17)
        install -d /etc/skel/.config
        cat > /etc/skel/.config/kdeglobals <<'EOF'
[KDE]
widgetStyle=Breeze

[General]
LookAndFeelPackage=org.kde.breezedark.desktop
EOF
        ;;
    gnome)
        log "desktop: GNOME"
        pacman -S --noconfirm --needed gnome gnome-tweaks gdm || { log "FATAL: GNOME install failed"; exit 16; }
        DM=gdm
        ;;
    xfce)
        log "desktop: XFCE"
        pacman -S --noconfirm --needed xfce4 xfce4-goodies sddm || { log "FATAL: XFCE install failed"; exit 16; }
        DM=sddm
        ;;
    lxqt)
        log "desktop: LXQt"
        pacman -S --noconfirm --needed lxqt sddm || { log "FATAL: LXQt install failed"; exit 16; }
        DM=sddm
        ;;
    none)
        log "desktop: none (CLI only)"
        ;;
    *)
        log "FATAL: unsupported desktop: $DESKTOP"
        exit 16
        ;;
esac
[ -z "$DM" ] || { systemctl enable "$DM.service" && log "display manager: $DM enabled"; }

# networking is a basic function (spec 09): NetworkManager always on when
# the package is present (the baked offline set carries it)
if pacman -Q networkmanager >/dev/null 2>&1; then
    systemctl enable NetworkManager.service && log "network: NetworkManager enabled"
fi

### brand the installed system (spec 14: welcome, not raw instructions) ###
cat > /etc/motd <<'EOF'
Welcome home, ronin — this is your Samurai OS.

Your blade is the `samurai` command:
  samurai update       refresh the system — a snapshot is taken first, always
  samurai snap         capture this moment before you act
  samurai rescue       for when the path darkens
  samurai toolbox      shape the machine to your hand
EOF
cat > /etc/issue <<'EOF'
Samurai OS \s \m (\l)

The blade awaits. Login:
EOF

### users ###
if ! id -u "$UNAME" >/dev/null 2>&1; then
    # The profile may carry a crypt password hash (sha512) for unattended
    # installs; plaintext passwords are FORBIDDEN in profiles. Interactive
    # installs prompt instead. A generated password lands at 0600 in /root.
    if [ -n "$UPWHASH" ]; then
        useradd -m -G wheel -s "/bin/$USHELL" "$UNAME"
        usermod -p "$UPWHASH" "$UNAME"
        log "user $UNAME created (password from profile hash)"
    else
        genpass() { tr -dc 'A-Za-z0-9' </dev/urandom | head -c 24; }
        UPASS="$(genpass)"
        useradd -m -G wheel -s "/bin/$USHELL" "$UNAME"
        printf '%s:%s\n' "$UNAME" "$UPASS" | chpasswd
        umask 077 && printf '%s : %s\n' "$UNAME" "$UPASS" > /root/initial-credentials && umask 022
        log "user $UNAME created (initial password in /root/initial-credentials, 0600)"
    fi
fi
passwd -l root || true

# wheel sudo, verified before activation
cat > /etc/sudoers.d/10-wheel <<'EOF'
%wheel ALL=(ALL:ALL) ALL
EOF
chmod 440 /etc/sudoers.d/10-wheel
visudo -c -q || { rm -f /etc/sudoers.d/10-wheel; log "FATAL: sudoers check failed"; exit 1; }

### mkinitcpio (hooks are written pre-pacstrap by the driver) ###
for k in $KERNELS; do
    log "mkinitcpio for $k"
    mkinitcpio --preset "$k" 2>&1 || log "mkinitcpio exited nonzero for $k"
done

ROOT_UUID="${SAMURAI_ROOT_UUID:-}"
LUKS_UUID="${SAMURAI_LUKS_UUID:-}"
ESP_UUID="${SAMURAI_ESP_UUID:-}"
# fallbacks for manual runs (the installer env file is authoritative)
if [ -z "$ROOT_UUID" ] && [ -f /etc/samurai-install-env ]; then
    . /etc/samurai-install-env
fi
ROOT_UUID="${SAMURAI_ROOT_UUID:-$ROOT_UUID}"
LUKS_UUID="${SAMURAI_LUKS_UUID:-$LUKS_UUID}"
ESP_UUID="${SAMURAI_ESP_UUID:-$ESP_UUID}"
# no /etc/crypttab: the initramfs unlock (rd.luks.uuid + embedded keyfile)
# names the mapper luks-<uuid> and the fstab addresses everything by UUID —
# a crypttab re-open of the same device just produces a failed unit.
if [ "$BLDR" = limine ]; then
    log "bootloader: Limine (ADR-0003)"
    # UEFI install via the firmware fallback path; the config lives next to
    # the binary. boot(): inside the config refers to the ESP.
    install -d /boot/EFI/BOOT /boot/limine
    install -m644 /usr/share/limine/BOOTX64.EFI /boot/EFI/BOOT/BOOTX64.EFI
    kopts="root=UUID=$ROOT_UUID rw rootflags=subvol=@ console=tty1 console=ttyS0,115200"
    if [ "$ENCRYPT" -eq 1 ]; then
        # LUKS_UUID comes from the installer env file (cryptsetup luksUUID on
        # the live side); the in-chroot blkid/lsblk derivation produced garbage
        [ -n "$LUKS_UUID" ] && kopts="$kopts rd.luks.uuid=$LUKS_UUID"
        if [ "$AUTOKEY" -eq 1 ]; then
            # keyfile is EMBEDDED in the initramfs (mkinitcpio FILES=()) — no
            # keydev mount needed during unlock
            kopts="$kopts rd.luks.key=/etc/cryptsetup-keys.d/samurai-root.key"
        fi
    fi
    {
        printf 'timeout: 3\n\n'
        printf '# Samurai OS boot entries (managed by samurai; snapshot\n'
        printf '# entries are added/removed by the snapshot boot sync)\n'
        for k in $KERNELS; do
            printf '/Samurai OS (%s)\n' "$k"
            printf '    protocol: linux\n'
            printf '    path: boot():/vmlinuz-%s\n' "$k"
            printf '    cmdline: %s\n' "$kopts"
            printf '    module_path: boot():/initramfs-%s.img\n' "$k"
            printf '\n'
        done
    } > /boot/limine/limine.conf
    log "limine.conf: $(tr '\n' ' ' < /boot/limine/limine.conf)"
    log "fstab: $(tr '\n' ' ' < /etc/fstab)"
elif [ "$BLDR" = grub ]; then
    log "bootloader: GRUB (user-selected)"
    # ESP is mounted at /boot; kernel cmdline matches the Limine branch so the
    # rescue/rollback path (rd.luks, embedded keyfile) behaves identically.
    grub_opts="root=UUID=$ROOT_UUID rw rootflags=subvol=@ console=tty1 console=ttyS0,115200"
    if [ "$ENCRYPT" -eq 1 ]; then
        [ -n "$LUKS_UUID" ] && grub_opts="$grub_opts rd.luks.uuid=$LUKS_UUID"
        if [ "$AUTOKEY" -eq 1 ]; then
            grub_opts="$grub_opts rd.luks.key=/etc/cryptsetup-keys.d/samurai-root.key"
        fi
    fi
    sed -i "s|^GRUB_CMDLINE_LINUX=.*|GRUB_CMDLINE_LINUX=\"$grub_opts\"|" /etc/default/grub
    sed -i 's|^GRUB_TIMEOUT=.*|GRUB_TIMEOUT=3|' /etc/default/grub
    grub-install --target=x86_64-efi --efi-directory=/boot \
        --bootloader-id=SamuraiOS --recheck 2>&1 || { log "FATAL: grub-install failed"; exit 14; }
    grub-mkconfig -o /boot/grub/grub.cfg 2>&1 | tail -3
    log "grub.cfg written ($(grep -c menuentry /boot/grub/grub.cfg 2>/dev/null || echo '?') entries)"
elif [ "$BLDR" = systemd-boot ]; then
    log "bootloader: systemd-boot (user-selected)"
    # kernel-install/bootctl: hand-written entries, same cmdline contract
    bootctl install --esp-path=/boot --no-variables 2>&1 || { log "FATAL: bootctl install failed"; exit 14; }
    sd_opts="root=UUID=$ROOT_UUID rw rootflags=subvol=@ console=tty1 console=ttyS0,115200"
    if [ "$ENCRYPT" -eq 1 ]; then
        [ -n "$LUKS_UUID" ] && sd_opts="$sd_opts rd.luks.uuid=$LUKS_UUID"
        if [ "$AUTOKEY" -eq 1 ]; then
            sd_opts="$sd_opts rd.luks.key=/etc/cryptsetup-keys.d/samurai-root.key"
        fi
    fi
    printf 'timeout 3\ndefault @saved\n' > /boot/loader/loader.conf
    install -d /boot/loader/entries
    for k in $KERNELS; do
        {
            printf 'title   Samurai OS (%s)\n' "$k"
            printf 'linux   /vmlinuz-%s\n' "$k"
            printf 'initrd  /initramfs-%s.img\n' "$k"
            printf 'options %s\n' "$sd_opts"
        } > "/boot/loader/entries/samurai-$k.conf"
    done
    log "systemd-boot entries: $(ls /boot/loader/entries/)"
elif [ "$BLDR" = refind ]; then
    log "bootloader: rEFInd (user-selected)"
    # refind-install in chroot targets the ESP at /boot; kernel autodetect
    # plus our refind_linux.conf carrying the same cmdline contract
    refind-install --yes 2>&1 || { log "FATAL: refind-install failed"; exit 14; }
    rf_opts="root=UUID=$ROOT_UUID rw rootflags=subvol=@ console=tty1 console=ttyS0,115200"
    if [ "$ENCRYPT" -eq 1 ]; then
        [ -n "$LUKS_UUID" ] && rf_opts="$rf_opts rd.luks.uuid=$LUKS_UUID"
        if [ "$AUTOKEY" -eq 1 ]; then
            rf_opts="$rf_opts rd.luks.key=/etc/cryptsetup-keys.d/samurai-root.key"
        fi
    fi
    printf '%s\n%s\n%s\n' \
        "\"Boot Samurai OS\" \"$rf_opts\"" \
        "\"Boot Samurai OS (fallback)\" \"$rf_opts nomodeset\"" \
        "\"Boot to EFI shell\" \"\"" > /boot/refind_linux.conf
    log "refind_linux.conf: $(tr '\n' ' ' < /boot/refind_linux.conf)"
else
    log "bootloader $BLDR is not supported (Limine is the one per ADR-0003)"
    exit 14
fi

### services ###
log "services"
systemctl enable qemu-guest-agent.service 2>/dev/null || true
systemctl enable systemd-networkd.service systemd-resolved.service

### snapshots (spec 06): snapper + snap-pac + maintenance timers ###
log "snapshots: snapper root config + snap-pac"
# @snapshots is pre-mounted at /.snapshots by the driver (spec 06 layout: it
# must survive root-subvol replacement).
if [ "${SAMURAI_CHROOT:-0}" != 1 ]; then
    # real system (toolbox-driven re-run): "/" is the @ mountpoint and the
    # snapper daemon owns the system — swap @snapshots out, create-config,
    # delete the subvol it makes, remount ours (fstab is authoritative).
    SWAP_SNAPSHOTS=0
    if mountpoint -q /.snapshots; then
        log "snapshots: /.snapshots pre-mounted (@snapshots) — swapping out for create-config"
        umount /.snapshots || { log "FATAL: cannot unmount /.snapshots"; exit 15; }
        rmdir /.snapshots
        SWAP_SNAPSHOTS=1
    fi
    if ! snapper -c root create-config / 2>&1; then
        log "FATAL: snapper create-config failed — no rollback support"
        exit 15
    fi
    if [ "$SWAP_SNAPSHOTS" -eq 1 ]; then
        btrfs subvolume delete /.snapshots 2>&1 | log || true  # the redundant one snapper just made
        mkdir -p /.snapshots
        mount /.snapshots || { log "FATAL: remount of @snapshots failed"; exit 15; }
    fi
    snapper -c root set-config 'TIMELINE_CREATE="no"' \
        'NUMBER_LIMIT="20"' 'NUMBER_LIMIT_IMPORTANT="10"' \
        'EMPTY_PRE_POST_CLEANUP="yes"' || log "WARNING: snapper set-config failed"
else
    # chroot (install): NEVER use `snapper create-config` here. Three layers
    # of failure observed 2026-11-18: (1) "/" is not a mountpoint in the
    # kernel's view inside a chroot; (2) --root + --no-dbus still detects the
    # live env's overlay fstype and refuses; (3) even with the right
    # mountpoint passed, the CLI stores configs in the LIVE /etc, not the
    # target. A snapper config is a plain key-value file: write it from the
    # shipped template. @snapshots stays mounted — no swap.
    if [ ! -f /etc/snapper/configs/root ]; then
        log "snapshots: writing root config from template (chroot-safe)"
        mkdir -p /etc/snapper/configs
        sed -e 's|^FSTYPE=.*|FSTYPE="btrfs"|' \
            -e 's|^SUBVOLUME=.*|SUBVOLUME="/"|' \
            -e 's|^TIMELINE_CREATE=.*|TIMELINE_CREATE="no"|' \
            -e 's|^NUMBER_LIMIT=.*|NUMBER_LIMIT="20"|' \
            -e 's|^NUMBER_LIMIT_IMPORTANT=.*|NUMBER_LIMIT_IMPORTANT="10"|' \
            -e 's|^EMPTY_PRE_POST_CLEANUP=.*|EMPTY_PRE_POST_CLEANUP="yes"|' \
            /usr/share/snapper/config-templates/default > /etc/snapper/configs/root \
            || { log "FATAL: cannot write snapper root config"; exit 15; }
    fi
    [ -d /.snapshots ] || mkdir -p /.snapshots
    mountpoint -q /.snapshots \
        || log "WARNING: /.snapshots not mounted in-chroot (fstab mounts @snapshots at boot)"
fi
# snap-pac 3.x discovers snapper configs on its own (no /etc/snap-pac.conf)
# pacman transactions: the important ones (kernel/systemd/glibc) get marked
# important so their pre/post pairs survive cleanup (spec 06)
install -d /etc/pacman.d/hooks
printf '%s\n' '[Trigger]' 'Operation = Install' 'Operation = Upgrade' \
    'Type = Package' 'Target = linux*' 'Target = systemd' 'Target = glibc' '' \
    '[Action]' 'When = PreTransaction' 'Exec = /usr/bin/sh -c "snapper -c root set-description $(snapper -c root list | awk "END{print $1}") important 2>/dev/null || true"' \
    > /etc/pacman.d/hooks/10-samurai-important-snap.hook
systemctl enable snapper.timer snapper-cleanup.timer 2>&1 | log || true
systemctl enable fstrim.timer 2>&1 | log || true
# network config lives on the ISO, not in the pacstrap'd target (learned: the
# updater's preflight died on "no network"). Write the basic DHCP config:
mkdir -p etc/systemd/network
printf '[Match]\nName=en* eth* wl*\n\n[Network]\nDHCP=yes\n' > etc/systemd/network/20-samurai.network
# resolved stub for DNS (only if absent: other resolvers may own this path)
[ -e etc/resolv.conf ] || ln -s /run/systemd/resolve/stub-resolv.conf etc/resolv.conf

### fingerprint + install info ###
mkdir -p /var/lib/samurai
{ lspci -nn 2>/dev/null || true; lsusb 2>/dev/null || true; } | sed 's/^/  /' > /var/lib/samurai/hw-fingerprint
cp "$PROFILE" /var/lib/samurai/install-profile.toml 2>/dev/null || true  # driver may have staged it already
[ -f /var/lib/samurai/install-profile.toml ] || cp "$PROFILE" /var/lib/samurai/install-profile.toml
python3 - <<'PY' > /var/lib/samurai/install-info.json
import json, os, platform, time
print(json.dumps({"version": 1, "arch": platform.machine(),
                  "completed": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                  "builder": "samurai-postinstall M2"}, indent=1))
PY

log "samurai-postinstall complete"
