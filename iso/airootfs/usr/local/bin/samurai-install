#!/usr/bin/env bash
# samurai-install — install driver (spec 08). Attended (guided) mode when run
# without --profile: asks the profile's questions, writes a validated TOML,
# then runs the SAME backend. Terminal/Calamares UIs produce the same profile
# and call this (GUI wrapper comes at M5/M7).
#
# Usage: samurai-install [--profile FILE] [--disk /dev/...] [--yes]
#   no --profile  => attended guided wizard (writes /tmp/samurai-attended.toml)
# Security posture (Genor 2026-11-17): strict profile validation before any disk
# is touched; no eval; every value quoted; all output logged for post-mortem.
# Passwords never enter the profile in plaintext (crypt hash only, or the
# postinstall generated-password path).
set -euo pipefail

PROFILE=""
DISK_OVERRIDE=""
ASSUME_YES=0
LOG=/var/log/samurai/install.log

# tee-to-stdout deadlocks when stdout is an undrained tty (agent-launched
# installs write to /dev/ttyS0 and nothing drains the host-side socket —
# pacman blocked in anon_pipe_write at a fixed byte count, seen 2026-11-20).
# Mirror to stdout only for a real terminal; otherwise log file only.
TLOG() { if [ -t 1 ]; then tee -a "$1"; else cat >> "$1"; fi; }

log() { printf '%s %s\n' "$(date -Is)" "$*" >> "$LOG"; [ -t 1 ] && printf '%s %s\n' "$(date -Is)" "$*" >&2 || true; }
die() { log "FATAL: $*"; echo "FATAL: $*" >&2; exit 1; }

mkdir -p /var/log/samurai
log "samurai-install starting: $*"

### Attended guided wizard (spec 08 Guided mode) ###
# Asks exactly the questions the profile schema supports; everything it does
# not ask keeps the profile default. Writes /tmp/samurai-attended.toml and
# falls through to the validated unattended backend unchanged.
wizard() {
    echo
    echo "  Samurai OS — guided install"
    echo "  ==========================="

    # requirements (spec 08 page 1): UEFI mandatory; RAM advisory at this set
    [ -d /sys/firmware/efi/efivars ] || die "attended install requires UEFI boot (this medium booted legacy/BIOS)"
    memmb=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo)
    [ "$memmb" -lt 3500 ] && die "needs >= 4 GiB RAM (found ${memmb} MiB)"
    echo "  UEFI boot: yes | RAM: ${memmb} MiB"

    # disk pick: real fixed disks only — lsblk TYPE=="disk" excludes cdrom
    # (rom), loop, ram and device-mapper; major-number filters are
    # kernel-dependent (virtio-blk and dm swap major 254; seen 2026-11-20:
    # -e 254 wiped out /dev/vda itself => "no disks found")
    echo
    echo "  Available disks:"
    mapfile -t disks < <(lsblk -dpno NAME,SIZE,TYPE,MODEL | awk '$3 == "disk"')
    [ ${#disks[@]} -gt 0 ] || die "no disks found"
    i=1; for d in "${disks[@]}"; do printf '    %d) %s\n' "$i" "$d"; i=$((i+1)); done
    read -r -p "  Disk to ERASE [1-${#disks[@]}]: " dnum
    case "$dnum" in ''|*[!0-9]*) die "invalid disk choice" ;; esac
    [ "$dnum" -ge 1 ] && [ "$dnum" -le ${#disks[@]} ] || die "invalid disk choice"
    WIZ_DISK=${disks[$((dnum-1))]%% *}
    echo "  -> $WIZ_DISK will be ERASED (all data lost)"

    # identity
    read -r -p "  Hostname [samurai]: " WIZ_HOST; WIZ_HOST=${WIZ_HOST:-samurai}
    echo "  Timezone regions:"
    mapfile -t tzregions < <(find /usr/share/zoneinfo -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)
    i=1; for r in "${tzregions[@]}"; do printf '    %d) %s\n' "$i" "$r"; i=$((i+1)); done
    printf '    %d) UTC\n' "$i"; nregions=$i
    read -r -p "  Region number [UTC]: " trn
    WIZ_TZ=UTC
    if [ -n "$trn" ] && [ "$trn" -ge 1 ] && [ "$trn" -lt "$nregions" ]; then
        region=${tzregions[$((trn-1))]}
        mapfile -t tzcities < <(find "/usr/share/zoneinfo/$region" -type f -printf '%P\n' | sort)
        j=1; for c in "${tzcities[@]}"; do printf '    %d) %s\n' "$j" "$c"; j=$((j+1)); done
        read -r -p "  City number: " cnum
        case "$cnum" in ''|*[!0-9]*) die "invalid city choice" ;; esac
        [ "$cnum" -ge 1 ] && [ "$cnum" -le ${#tzcities[@]} ] || die "invalid city choice"
        WIZ_TZ="$region/${tzcities[$((cnum-1))]}"
    fi
    [ -f "/usr/share/zoneinfo/$WIZ_TZ" ] || [ "$WIZ_TZ" = UTC ] || die "bad timezone: $WIZ_TZ"

    # encryption: on by default (spec 08 page 3). The LUKS passphrase itself is
    # asked later by the backend (masked, confirmed) — the wizard never sees it.
    read -r -p "  LUKS2 disk encryption [Y/n]: " enc
    case "$enc" in n|N) WIZ_ENC=false ;; *) WIZ_ENC=true ;; esac

    # kernels (multi-select). Default = the release default (ADR-0001):
    # linux-cachyos + linux-zen — the ISO now ships the [cachyos] repo and
    # the baked offline cache covers both
    echo "  Kernels: 1) linux-cachyos  2) linux-zen  3) linux  4) linux-lts  5) linux-cachyos-lts"
    read -r -p "  Numbers, space-separated [1 2]: " ksel; ksel=${ksel:-1 2}
    WIZ_KERNELS=""
    for k in $ksel; do
        case "$k" in
            1) WIZ_KERNELS="$WIZ_KERNELS linux-cachyos" ;;
            2) WIZ_KERNELS="$WIZ_KERNELS linux-zen" ;;
            3) WIZ_KERNELS="$WIZ_KERNELS linux" ;;
            4) WIZ_KERNELS="$WIZ_KERNELS linux-lts" ;;
            5) WIZ_KERNELS="$WIZ_KERNELS linux-cachyos-lts" ;;
            *) die "invalid kernel choice: $k" ;;
        esac
    done
    [ -n "$WIZ_KERNELS" ] || die "pick at least one kernel"

    # bootloader (spec 08 page 5a; Limine default per ADR-0003)
    echo "  Bootloader: 1) Limine (default)  2) GRUB  3) systemd-boot  4) rEFInd"
    read -r -p "  Choice [1]: " bsel; bsel=${bsel:-1}
    case "$bsel" in
        1) WIZ_BLDR=limine ;; 2) WIZ_BLDR=grub ;; 3) WIZ_BLDR=systemd-boot ;; 4) WIZ_BLDR=refind ;;
        *) die "invalid bootloader choice" ;;
    esac

    # desktop (spec 08: KDE Plasma default; alternatives opt-in)
    echo "  Desktop: 1) KDE Plasma (default)  2) GNOME  3) XFCE  4) LXQt  5) CLI only"
    read -r -p "  Choice [1]: " dsel; dsel=${dsel:-1}
    case "$dsel" in
        1) WIZ_DESKTOP=kde ;; 2) WIZ_DESKTOP=gnome ;; 3) WIZ_DESKTOP=xfce ;; 4) WIZ_DESKTOP=lxqt ;; 5) WIZ_DESKTOP=none ;;
        *) die "invalid desktop choice" ;;
    esac
    [ "$WIZ_DESKTOP" = none ] || [ "$memmb" -ge 7000 ] || \
        echo "  note: a desktop feels best with >= 8 GiB RAM (this box has ${memmb} MiB)"

    # user
    read -r -p "  Username [samurai]: " WIZ_USER; WIZ_USER=${WIZ_USER:-samurai}
    echo "  Shell: 1) bash  2) fish  3) zsh"
    read -r -p "  Choice [1]: " ssel; ssel=${ssel:-1}
    case "$ssel" in 1) WIZ_SHELL=bash ;; 2) WIZ_SHELL=fish ;; 3) WIZ_SHELL=zsh ;; *) die "invalid shell" ;; esac
    # password: hashed with openssl passwd -6 immediately; plaintext never
    # reaches the profile file. Empty twice => postinstall generates one and
    # drops it in /root/initial-credentials (0600).
    read -r -s -p "  User password (Enter = generate): " p1; echo
    read -r -s -p "  again: " p2; echo
    WIZ_PWHASH=""
    if [ -n "$p1" ]; then
        [ "$p1" = "$p2" ] || die "passwords do not match"
        WIZ_PWHASH=$(openssl passwd -6 "$p1")
    fi

    # summary + last-chance confirm (the backend asks its own Proceed? too)
    echo
    echo "  ---------------------------------------------"
    echo "  ERASE:   $WIZ_DISK (all data lost)"
    echo "  LUKS2:   $WIZ_ENC"
    echo "  host:    $WIZ_HOST | tz: $WIZ_TZ"
    echo "  kernels:$(echo $WIZ_KERNELS) | bootloader: $WIZ_BLDR"
    echo "  desktop: $WIZ_DESKTOP"
    echo "  user:    $WIZ_USER ($WIZ_SHELL)"
    echo "  ---------------------------------------------"
    read -r -p "  Write this profile and continue? [yes/no]: " go
    [ "$go" = yes ] || die "aborted at summary"

    WIZ_PROFILE=/tmp/samurai-attended.toml
    {
        printf 'version = 1\n\n[system]\nhostname = "%s"\ntimezone = "%s"\nlocale = "en_US.UTF-8"\nkeyboard = "us"\n\n' \
            "$WIZ_HOST" "$WIZ_TZ"
        printf '[disk]\ndevice = "%s"\nlayout = "erase"\nfilesystem = "btrfs"\nencryption = %s\nauto_unlock_keyfile = false\n\n' \
            "$WIZ_DISK" "$WIZ_ENC"
        printf '[boot]\nkernels = [%s]\nbootloader = "%s"\n\n' \
            "$(printf '"%s", ' $WIZ_KERNELS | sed 's/, $//')" "$WIZ_BLDR"
        printf '[user]\nname = "%s"\nshell = "%s"\ngroups = ["wheel"]\nroot_locked = true\n' \
            "$WIZ_USER" "$WIZ_SHELL"
        [ -n "$WIZ_PWHASH" ] && printf 'password_hash = "%s"\n' "$WIZ_PWHASH"
        printf '\n[packages]\ndesktop = "%s"\ninstall = [\n    "samurai-release",\n    "samurai-mirrorlist",\n    "samurai-keyring",\n    "qemu-guest-agent",\n    "networkmanager",\n    "wpa_supplicant",\n]\n\n[repos]\nsamurai = true\ncachyos = true\nchaotic_aur = false\narch_mirror = "auto"\n\n[security]\nfirewall = "none"\nssh_server = false\n' \
            "$WIZ_DESKTOP"
    } > "$WIZ_PROFILE"
    chmod 600 "$WIZ_PROFILE"
    log "wizard wrote $WIZ_PROFILE (disk=$WIZ_DISK enc=$WIZ_ENC bldr=$WIZ_BLDR)"
    PROFILE=$WIZ_PROFILE
}

while [ $# -gt 0 ]; do
    case "$1" in
        --profile) PROFILE="${2:?}"; shift 2 ;;
        --disk) DISK_OVERRIDE="${2:?}"; shift 2 ;;
        --yes) ASSUME_YES=1; shift ;;
        *) die "unknown argument: $1" ;;
    esac
done
if [ -z "$PROFILE" ]; then
    wizard
fi
[ -f "$PROFILE" ] || die "profile not found: $PROFILE"

validator=/usr/local/bin/validate-profile.py
[ -f "$validator" ] || die "missing $validator"

# Validation first: nothing touches a disk before the profile is proven sane.
python3 "$validator" "$PROFILE" || die "profile validation failed"

# Apply the CLI disk override through the validator too (never bypass it).
if [ -n "$DISK_OVERRIDE" ]; then
    sed -E "s|^device = .*|device = \"${DISK_OVERRIDE}\"|" "$PROFILE" > /tmp/profile-disk.toml
    PROFILE=/tmp/profile-disk.toml
    python3 "$validator" "$PROFILE" || die "disk override failed validation"
fi

# Pull validated values (strict regexes already passed; read via toml for quoting)
read -r HOSTNAME TZ DISK DEVICE_ENCRYPT AUTOKEY \
    < <(python3 - "$PROFILE" <<'PY'
import sys, tomllib
p = tomllib.loads(open(sys.argv[1]).read())
d = p.get("disk", {})
s = p.get("system", {})
print(s.get("hostname", "samurai"), s.get("timezone", "UTC"),
      d.get("device", ""), int(bool(d.get("encryption", True))),
      int(bool(d.get("auto_unlock_keyfile", False))))
PY
) || die "profile read failed"

read -r -a KERNEL_ARR \
    < <(python3 - "$PROFILE" <<'PY'
import sys, tomllib
p = tomllib.loads(open(sys.argv[1]).read())
print(" ".join(p.get("boot", {}).get("kernels", ["linux"])))
PY
) || die "kernels read failed"
read -r USER_NAME USER_SHELL BLDR \
    < <(python3 - "$PROFILE" <<'PY'
import sys, tomllib
p = tomllib.loads(open(sys.argv[1]).read())
u = p.get("user", {})
print(u.get("name", "samurai"), u.get("shell", "bash"),
      p.get("boot", {}).get("bootloader", "limine"))
PY
) || die "user read failed"
KERNELS="${KERNEL_ARR[*]}"
# bootloader package set: limine is default (ADR-0003); grub/systemd-boot/refind
# opt-in via [boot].bootloader. snapper/snap-pac stay unconditional (snapshots
# are core, not bootloader-bound). ARRAY on purpose: a quoted multi-word
# string made pacstrap look for a package literally named "grub os-prober
# efibootmgr" (seen 2026-11-20, first GRUB-path install).
BLDR_PKGS=(limine)
case "$BLDR" in
    grub)         BLDR_PKGS=(grub os-prober efibootmgr) ;;
    systemd-boot) BLDR_PKGS=(efibootmgr) ;;
    refind)       BLDR_PKGS=(refind efibootmgr) ;;
    limine)       BLDR_PKGS=(limine) ;;
    *)            die "unsupported bootloader: $BLDR" ;;
esac

[ -b "$DISK" ] || die "not a block device: $DISK"

cat >> "$LOG" <<EOF
plan: erase $DISK, LUKS2=$DEVICE_ENCRYPT, hostname=$HOSTNAME, tz=$TZ
plan: kernels=$KERNELS user=$USER_NAME shell=$USER_SHELL
EOF
echo "==> Plan: ERASE $DISK | LUKS2=$DEVICE_ENCRYPT | host=$HOSTNAME | kernels=$KERNELS"
if [ "$ASSUME_YES" -ne 1 ]; then
    read -r -p "Proceed? [yes/no] " answer
    [ "$answer" = "yes" ] || die "aborted by user"
fi

### Partitioning (erase only in M2) ###
log "partitioning $DISK"
sgdisk -Z "$DISK"
sgdisk -n 1:0:+2G -t 1:ef00 -c 1:esp "$DISK"   # ESP (2 GiB: kernels each snapshot entry needs, spec 06)
sgdisk -n 2:0:0 -t 2:8304 -c 2:samurai-root "$DISK"  # Linux x86-64 root (/usr split ok)
partprobe "$DISK"; sleep 1
ESP="${DISK}1"; ROOTPART="${DISK}2"
[ -b "$ESP" ] && [ -b "$ROOTPART" ] || die "partitioning failed"
mkfs.fat -F32 -n ESP "$ESP"

### LUKS2 + btrfs subvolumes (spec 06 flat layout) ###
ROOTMAP="samurai-root"
if [ "$DEVICE_ENCRYPT" -eq 1 ]; then
    keyfile=/run/samurai.key
    dd if=/dev/urandom of="$keyfile" bs=512 count=8
    chmod 600 "$keyfile"
    if [ "$AUTOKEY" -eq 1 ]; then
        # headless/VM path: keyfile unlock, then it is also copied to the ESP
        # below so the boot entry can unlock unattended. Profile-gated: real
        # installs keep the passphrase prompt.
        cryptsetup luksFormat --type luks2 --batch-mode \
            --key-file "$keyfile" --pbkdf argon2id "$ROOTPART"
        cryptsetup luksAddKey "$ROOTPART" "$keyfile" --key-file "$keyfile"
    else
        read -r -s -p "LUKS passphrase: " pass1; echo
        read -r -s -p "LUKS passphrase (again): " pass2; echo
        [ "$pass1" = "$pass2" ] || die "passphrases do not match"
        printf '%s' "$pass1" | cryptsetup luksFormat --type luks2 --batch-mode "$ROOTPART"
        printf '%s' "$pass1" | cryptsetup luksAddKey "$ROOTPART" "$keyfile"
    fi
    cryptsetup open "$ROOTPART" "$ROOTMAP" --key-file "$keyfile"
    ROOTDEV="/dev/mapper/$ROOTMAP"
else
    ROOTDEV="$ROOTPART"
fi
log "creating btrfs on $ROOTDEV"
mkfs.btrfs -f -L samurai "$ROOTDEV"
mount "$ROOTDEV" /mnt
for sub in @ @home @root @srv @cache @log @tmp @containers @vm @snapshots; do
    btrfs subvolume create "/mnt/$sub"
done
umount /mnt
mount -o subvol=@,compress=zstd:1,noatime "$ROOTDEV" /mnt
mkdir -p /mnt/{boot,home,root,srv,var/cache,var/log,var/tmp,var/lib/docker,var/lib/containers,var/lib/libvirt/images,.snapshots}
mount -o subvol=@home,compress=zstd:1,noatime "$ROOTDEV" /mnt/home
mount -o subvol=@root,noatime "$ROOTDEV" /mnt/root
mount -o subvol=@srv,noatime "$ROOTDEV" /mnt/srv
mount -o subvol=@cache,noatime "$ROOTDEV" /mnt/var/cache
mount -o subvol=@log,noatime "$ROOTDEV" /mnt/var/log
mount -o subvol=@tmp,noatime "$ROOTDEV" /mnt/var/tmp
mount -o subvol=@containers,noatime "$ROOTDEV" /mnt/var/lib/docker
mount -o subvol=@vm,nodatacow,noatime "$ROOTDEV" /mnt/var/lib/libvirt/images
mount -o subvol=@snapshots,noatime "$ROOTDEV" /mnt/.snapshots
mount "$ESP" /mnt/boot

# mkinitcpio hooks go in BEFORE pacstrap so the kernel's own mkinitcpio hook
# inside the transaction builds with OUR hooks, not the base defaults
HOOKS="base systemd autodetect modconf kms keyboard sd-vconsole block filesystems fsck"
MODULES=""
if [ "$DEVICE_ENCRYPT" -eq 1 ]; then
    HOOKS="base systemd autodetect modconf kms keyboard sd-vconsole sd-encrypt block filesystems fsck"
    # the LUKS keyfile lives on the vfat ESP: the initramfs must be able to
    # mount it (autodetect prunes vfat otherwise) — learned the hard way
    MODULES="vfat nls_cp437 nls_ascii"
fi
mkdir -p /mnt/etc/mkinitcpio.conf.d
{
    printf 'HOOKS=(%s)\n' "$HOOKS"
    [ -n "$MODULES" ] && printf 'MODULES=(%s)\n' "$MODULES"
    if [ "$DEVICE_ENCRYPT" -eq 1 ] && [ "$AUTOKEY" -eq 1 ]; then
        printf 'FILES=(/etc/cryptsetup-keys.d/samurai-root.key)\n'
    fi
} > /mnt/etc/mkinitcpio.conf.d/10-samurai.conf

### LUKS boot wiring (before postinstall: boot entries reference the keyfile) ###
if [ "$DEVICE_ENCRYPT" -eq 1 ] && [ "$AUTOKEY" -eq 1 ]; then
    mkdir -p /mnt/boot/keys /mnt/etc/cryptsetup-keys.d
    cp "$keyfile" /mnt/boot/keys/samurai.key
    chmod 600 /mnt/boot/keys/samurai.key
    # the unlock key is ALSO embedded in the initramfs (FILES= below): the
    # ESP-mount-in-initramfs path proved fragile; reading the key from the
    # initramfs itself is deterministic. Same threat model: both live on the
    # unencrypted ESP. Real installs use the passphrase prompt or TPM (spec 09).
    cp "$keyfile" /mnt/etc/cryptsetup-keys.d/samurai-root.key
    chmod 600 /mnt/etc/cryptsetup-keys.d/samurai-root.key
fi

### Base install ###
log "installing base system"
# archive-pinned installs (spec 11 update-from-archive): the profile's
# repos.arch_mirror replaces the live mirrorlist so pacstrap AND the target
# download from the pinned snapshot; the updater rewrites it on first update
ARCH_MIRROR=$(python3 - "$PROFILE" <<'PY'
import sys, tomllib
p = tomllib.loads(open(sys.argv[1]).read())
print(p.get("repos", {}).get("arch_mirror", "auto"))
PY
)
if [ "$ARCH_MIRROR" != "auto" ] && [ -n "$ARCH_MIRROR" ]; then
    log "mirrors: pinning to $ARCH_MIRROR"
    # strip a trailing slash and append $repo/os/$arch: pacman only expands
    # those placeholders when the Server line contains them — a plain URL
    # makes it fetch <server>/<repo>.db (the 404 we chased for an hour)
    printf 'Server = %s\n' "${ARCH_MIRROR%/}/\$repo/os/\$arch" > /etc/pacman.d/mirrorlist
fi

# Desktop choice decides the offline path: the baked cache covers the KDE
# release default set (Genor 2026-11-20: base version installable without
# network). Other choices fall back to the network.
read -r DESKTOP < <(python3 - "$PROFILE" <<'PY'
import sys, tomllib
p = tomllib.loads(open(sys.argv[1]).read())
print(p.get("packages", {}).get("desktop", "kde"))
PY
) || die "desktop read failed"

OFFLINE_DIR=/usr/share/samurai/pkg-cache
OFFLINE_OK=0
if [ "$DESKTOP" = kde ] && [ -d "$OFFLINE_DIR" ] && compgen -G "$OFFLINE_DIR/*.pkg.tar.zst" >/dev/null; then
    log "offline install: baked cache present — installing from files (no network)"
    mkdir -p /mnt/var/lib/pacman /mnt/etc/pacman.d/gnupg
    # pre-init the target keyring: archlinux/cachyos-keyring run --populate
    # hooks on install, and an empty keyring would fail them (pacman exits 1)
    pacman-key --gpgdir /mnt/etc/pacman.d/gnupg --init >/dev/null 2>&1 || true
    # signatures were verified when the cache was built; the ISO itself is
    # the trust anchor. -U needs no repos, no sync dbs, no mirrorlist.
    # pacman --sysroot resolves --config inside the target; stage it there so
    # hooks and libalpm use the target root rather than the live ISO.
    mkdir -p /mnt/tmp
    printf '[options]\nSigLevel = Never\nLocalFileSigLevel = Never\nArchitecture = auto\n' > /mnt/tmp/pacman-offline.conf
    # sysroot hooks execute in the target chroot. Supply the pseudo-filesystems
    # needed by mkinitcpio and pacman-key; non-recursive binds avoid importing
    # busy live-ISO device/pts, efivarfs, cgroup, archiso and runtime mounts.
    mkdir -p /mnt/dev /mnt/proc /mnt/sys /mnt/run
    mount --bind /dev /mnt/dev
    mount --make-rslave /mnt/dev
    mount -t proc proc /mnt/proc
    mount --bind /sys /mnt/sys
    mount --make-rslave /mnt/sys
    mount --bind /run /mnt/run
    mount --make-rslave /mnt/run
    # kernel selection: drop UNCHOSEN kernels (and their -headers) from the
    # list; match the exact kernel package names only — a blanket "linux-*"
    # case would eat linux-firmware and friends (seen 2026-11-20)
    PKG_LIST=()
    for f in "$OFFLINE_DIR"/*.pkg.tar.zst; do
        b=$(basename "$f"); keep=1
        for k in linux linux-lts linux-zen linux-cachyos linux-cachyos-lts; do
            case " ${KERNEL_ARR[*]} " in *" $k "*) continue ;; esac
            case "$b" in "$k"-[0-9]*|"$k"-headers-[0-9]*) keep=0 ;; esac
        done
        [ "$keep" = 1 ] && PKG_LIST+=("$f")
    done
    set +e
    # --root relocates pacman's files but is not suitable for a mounted guest:
    # transaction hooks then inspect the live ISO instead of the target. --sysroot
    # makes libalpm operate on the mounted installation, including kernel hooks.
    pacman --config /tmp/pacman-offline.conf --sysroot /mnt -U --noconfirm "${PKG_LIST[@]}" 2>&1 | TLOG "$LOG"
    PACSTAT=${PIPESTATUS[0]}
    set -e
    # Package hooks may start a GPG agent inside the target chroot. Its
    # /dev/null descriptors pin this devtmpfs bind, so stop it from the same
    # root/homedir namespace before unmounting.
    chroot /mnt gpgconf --homedir /etc/pacman.d/gnupg --kill gpg-agent >/dev/null 2>&1 || true
    rm -f /mnt/tmp/pacman-offline.conf
    umount /mnt/proc
    umount /mnt/sys
    umount /mnt/run
    if [ "$PACSTAT" -eq 0 ]; then
        OFFLINE_OK=1
        log "offline install: closure installed from baked cache"
    else
        log "offline cache incomplete for this set — falling back to network install over the partial target"
        # no deletion: pacstrap --needed over the partial -U target completes
        # whatever the cache missed
    fi
fi
if [ "$OFFLINE_OK" -ne 1 ]; then
    pacman -Sy --noconfirm --needed archlinux-keyring 2>/dev/null || true
    pacstrap -K /mnt base "${KERNEL_ARR[@]}" linux-firmware mkinitcpio sudo fish python pciutils "${BLDR_PKGS[@]}" snapper snap-pac 2>&1 | TLOG "$LOG"
fi
[ -d /mnt/etc ] || die "install failed (offline and network paths both)"
# The live ISO's pacman config enables CachyOS and Samurai. pacstrap's -C
# affects package resolution only; it does not install that config into the
# target. Copy it in both online and offline installs so the repos remain
# enabled after reboot (ADR-0007).
cp /etc/pacman.conf /mnt/etc/pacman.conf
mkdir -p /mnt/etc/pacman.d
cp -a /etc/pacman.d/. /mnt/etc/pacman.d/ 2>/dev/null || true

# the postinstall runs in the TARGET: bring it + its deps over first
# (same bug class as above: the target has neither the script nor the
# baked [samurai] key/mirrorlist — the live ISO is not visible in the chroot)
cp /usr/local/bin/samurai-postinstall /mnt/usr/local/bin/
chmod 755 /mnt/usr/local/bin/samurai-postinstall
cp /usr/local/bin/samurai-update /mnt/usr/local/bin/
cp /usr/local/bin/samurai /mnt/usr/local/bin/
chmod 755 /mnt/usr/local/bin/samurai-update /mnt/usr/local/bin/samurai
chmod 755 /mnt/usr/local/bin/samurai-update
mkdir -p /mnt/usr/lib/samurai/interventions
cp /usr/lib/samurai/interventions/* /mnt/usr/lib/samurai/interventions/ 2>/dev/null || true
mkdir -p /mnt/usr/share/samurai
cp /usr/share/samurai/build-key.txt /mnt/usr/share/samurai/ 2>/dev/null || true
cp /usr/share/samurai/samurai-mirrorlist /mnt/usr/share/samurai/ 2>/dev/null || true

genfstab -U /mnt >> /mnt/etc/fstab
log "fstab written"

### Apply the profile in the target ###
mkdir -p /mnt/var/lib/samurai
cp "$PROFILE" /mnt/var/lib/samurai/install-profile.toml
# pass the install-time facts to postinstall (never re-derive them in the
# chroot: blkid/lsblk there gave garbage rd.luks params once already)
ROOT_UUID=$(blkid -s UUID -o value "$ROOTDEV")
LUKS_UUID=""; ESP_UUID=""
[ "$DEVICE_ENCRYPT" -eq 1 ] && LUKS_UUID=$(cryptsetup luksUUID "$ROOTPART")
ESP_UUID=$(blkid -s UUID -o value "$ESP")
cat > /mnt/etc/samurai-install-env <<EOF
SAMURAI_ROOT_UUID=$ROOT_UUID
SAMURAI_LUKS_UUID=$LUKS_UUID
SAMURAI_ESP_UUID=$ESP_UUID
SAMURAI_ENCRYPT=$DEVICE_ENCRYPT
SAMURAI_AUTOKEY=$AUTOKEY
EOF
chmod 644 /mnt/etc/samurai-install-env
log "running samurai-postinstall"
arch-chroot /mnt env SAMURAI_CHROOT=1 SAMURAI_OFFLINE=$OFFLINE_OK /usr/local/bin/samurai-postinstall /var/lib/samurai/install-profile.toml 2>&1 | TLOG "$LOG"

# A successful pacman transaction is not enough: kernel hooks can fail while
# pacman itself exits 0. Refuse to produce an install whose selected Limine,
# GRUB, systemd-boot, or rEFInd entries point at missing ESP artifacts.
for k in "${KERNEL_ARR[@]}"; do
    [ -s "/mnt/boot/vmlinuz-$k" ] || die "kernel image missing after postinstall: /boot/vmlinuz-$k"
    [ -s "/mnt/boot/initramfs-$k.img" ] || die "initramfs missing after postinstall: /boot/initramfs-$k.img"
done

### first snapshot: install-complete (spec 06). Created LIVE-side: the install
### chroot has no snapper daemon (and "/" isn't a mountpoint there), so the
### snap-pac hooks fire during no transaction and a fresh install would have
### ZERO snapshots — the rescue/rollback path (M4) depends on this one.
### Layout matches snapper: /@snapshots/<num>/{info.xml,snapshot-subvol}.
if [ -d /mnt/.snapshots ] && mountpoint -q /mnt/.snapshots; then
    # NOTE: grep exits 1 when no numbered dirs exist (fresh install) — without
    # "|| true" that status kills this set -e script silently (seen 2026-11-18:
    # driver died right after postinstall with no message).
    NEXTID=$(ls -1 /mnt/.snapshots 2>/dev/null | grep -E '^[0-9]+$' | sort -n | tail -1 || true)
    NEXTID=$(( ${NEXTID:-0} + 1 ))
    log "snapshots: creating install-complete snapshot #$NEXTID"
    mkdir -p "/mnt/.snapshots/$NEXTID"
    btrfs subvolume snapshot -r /mnt "/mnt/.snapshots/$NEXTID/snapshot" 2>&1 | TLOG "$LOG" \
        || die "install-complete snapshot failed"
    cat > "/mnt/.snapshots/$NEXTID/info.xml" <<EOF
<?xml version="1.0"?>
<snapshot>
  <type>single</type>
  <num>$NEXTID</num>
  <date>$(date '+%Y-%m-%d %H:%M:%S')</date>
  <uid>0</uid>
  <desc>install-complete</desc>
  <cleanup>number</cleanup>
</snapshot>
EOF
else
    log "WARNING: /mnt/.snapshots not mounted — skipping install-complete snapshot"
fi

# postinstall's pacman-key --init can start another target-root agent.
chroot /mnt gpgconf --homedir /etc/pacman.d/gnupg --kill gpg-agent >/dev/null 2>&1 || true
log "install complete; unmounting"
# keep the install log on the installed system too (spec 08 forensics: the
# log previously lived only on the live medium and vanished after reboot)
mkdir -p /mnt/var/log/samurai
cp "$LOG" /mnt/var/log/samurai/install.log
umount -R /mnt
[ "$DEVICE_ENCRYPT" -eq 1 ] && cryptsetup close "$ROOTMAP"
log "DONE"
echo "==> Install complete. Reboot to start the new system."
