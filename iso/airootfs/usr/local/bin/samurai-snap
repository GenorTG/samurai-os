#!/usr/bin/env bash
# samurai snap — snapshot manager CLI (spec 06).
# Refuses to run when booted FROM a snapshot (updating/rolling back from a
# read-only overlay would lie about the state); rescue rollback is the path
# that works from outside the system.
set -euo pipefail
export LC_ALL=C

log() { printf '%s %s\n' "$(date -Is)" "$*"; }
die() { printf 'FATAL: %s\n' "$*" >&2; exit "${2:-1}"; }

CONFIG="root"
# run inside the restored root: its kernels -> /boot, then every initramfs preset and the menu
RESTORE_BOOT='found=0
for d in /usr/lib/modules/*; do
    [ -f "$d/pkgbase" ] && [ -f "$d/vmlinuz" ] || continue
    install -m644 "$d/vmlinuz" "/boot/vmlinuz-$(cat "$d/pkgbase")"; found=1
done
[ "$found" -eq 1 ]
mkinitcpio -P
if command -v samurai >/dev/null && samurai boot --help >/dev/null 2>&1; then samurai boot sync; fi'
cmd="${1:-list}"; shift 2>/dev/null || true

booted_from_snapshot() {
    findmnt -n -o SOURCE / 2>/dev/null | grep -qs '\.snapshots' \
        || grep -qs 'snapshots' /proc/cmdline 2>/dev/null
}

require_snapper() { command -v snapper >/dev/null 2>&1 || die "snapper is not installed"; }

case "$cmd" in
    list)
        require_snapper
        if [ "${1:-}" = --json ]; then
            # machine-readable (schema 1) for the toolbox; snapshot 0 is the live system
            raw=$(snapper --jsonout -c "$CONFIG" list --columns number,type,date,description,cleanup) \
                || die "snapper cannot list config $CONFIG (needs root)"
            printf '%s' "$raw" | python3 -I -c '
import json, sys
config = sys.argv[1]
rows = json.load(sys.stdin).get(config, [])
print(json.dumps({"schema": 1, "config": config, "snapshots": [
    {"id": r["number"], "type": r.get("type") or "", "date": r.get("date") or "",
     "description": r.get("description") or "", "cleanup": r.get("cleanup") or ""}
    for r in rows if r.get("number")]}))
' "$CONFIG"
            exit 0
        fi
        [ $# -eq 0 ] || die "usage: samurai snap list [--json]" 2
        echo "== snapshots (config: $CONFIG) =="
        snapper -c "$CONFIG" list
        echo "== bootable snapshot entries (ESP) =="
        grep -E '^/' /boot/limine/limine.conf 2>/dev/null | grep -E 'snapshot' | head -10 || echo "(none in limine.conf)"
        ;;

    create)
        require_snapper
        label="${1:-samurai-manual}"
        snapper -c "$CONFIG" create --description "$label"
        log "created snapshot ($label)"
        ;;

    delete)
        require_snapper
        id="${1:?usage: samurai snap delete <id>}"
        snapper -c "$CONFIG" delete "$id"
        log "deleted snapshot $id"
        ;;

    diff)
        require_snapper
        [ $# -ge 2 ] || die "usage: samurai snap diff <from> [to]"
        from="$1"; to="${2:-.}"
        snapper -c "$CONFIG" status "$from" "$to" 2>/dev/null | head -50
        echo "files: +created -deleted m=modified"
        ;;

    restore-file)
        require_snapper
        [ "$(id -u)" -eq 0 ] || die "restore-file needs root"
        [ $# -ge 2 ] || die "usage: samurai snap restore-file <snapshot-id> </absolute/path>"
        id="$1"; path="$2"
        case "$path" in /*) : ;; *) die "path must be absolute: $path" ;; esac
        src="/.snapshots/$id/snapshot$path"
        [ -e "$src" ] || die "not in snapshot $id: $path"
        if [ -e "$path" ]; then
            backup="$path.before-restore-$(date +%Y%m%d-%H%M%S)"
            cp -a -- "$path" "$backup"
            log "current version kept as $backup"
        fi
        cp -a -- "$src" "$path"
        log "restored $path from snapshot $id"
        ;;

    repair)
        require_snapper
        [ "$(id -u)" -eq 0 ] || die "repair needs root"
        # snapperd only loads the configs listed in SNAPPER_CONFIGS
        # (/etc/conf.d/snapper on Arch); a config file written by hand (the
        # installer does that inside the chroot, where create-config cannot
        # run) is "Unknown config" over D-Bus until it is listed there.
        SYSCONF=/etc/conf.d/snapper
        if [ -f "/etc/snapper/configs/$CONFIG" ] \
           && ! grep -qsE "^SNAPPER_CONFIGS=\"?([^\"]* )?$CONFIG( [^\"]*)?\"?\$" "$SYSCONF"; then
            if grep -qs '^SNAPPER_CONFIGS=' "$SYSCONF"; then
                sed -i -E "s/^SNAPPER_CONFIGS=\"?([^\"]*)\"?\$/SNAPPER_CONFIGS=\"\\1 $CONFIG\"/; s/=\" /=\"/" "$SYSCONF"
            else
                printf 'SNAPPER_CONFIGS="%s"\n' "$CONFIG" >> "$SYSCONF"
            fi
            # a running snapperd read the old list at startup; D-Bus restarts it on demand
            systemctl stop snapperd.service >/dev/null 2>&1 || true
            log "registered config $CONFIG in $SYSCONF"
        fi
        if ! snapper -c "$CONFIG" list >/dev/null 2>&1; then
            if [ -f "/etc/snapper/configs/$CONFIG" ]; then
                snapper -c "$CONFIG" list 2>&1 | log || true
                die "config $CONFIG exists but snapper cannot use it (see above) — check SUBVOLUME/FSTYPE in /etc/snapper/configs/$CONFIG"
            fi
            snapper -c "$CONFIG" create-config /
            log "recreated snapper config $CONFIG"
        fi
        snapper -c "$CONFIG" set-config 'TIMELINE_CREATE="no"' 'NUMBER_LIMIT="20"' 'NUMBER_LIMIT_IMPORTANT="10"' 'EMPTY_PRE_POST_CLEANUP="yes"' 2>&1 | log || true
        systemctl enable snapper.timer snapper-cleanup.timer >/dev/null 2>&1 || true
        log "snapper config $CONFIG repaired"
        ;;

    rollback)
        require_snapper
        # spec 06: 1) snapshot the current (broken) @ as before-rollback;
        # 2) rename the target snapshot to a new writable @ (old @ becomes
        #    @-broken-<timestamp>); 3) regenerate boot entries; 4) reboot.
        [ "$(id -u)" -eq 0 ] || die "rollback needs root"
        target="${1:?usage: samurai snap rollback [<snapshot-id>]}"
        if booted_from_snapshot; then
            die "booted from a snapshot: boot the CURRENT system first, then roll back (or use samurai rescue rollback)"
        fi
        # "|| true": grep exits 1 when OPTIONS has no subvol= entry — under
        # set -e that would kill this script silently (same bug class as the
        # NEXTID one, fixed 2026-11-18 in installer/samurai-install)
        subvol_opts=$(findmnt -n -o OPTIONS / | tr ',' '\n' | grep -E '^subvol=' | head -1 || true)
        subvol_root="${subvol_opts#subvol=}"
        case "$subvol_root" in
            /@) : ;;
            *) die "root subvol is '$subvol_root' — expected /@ (snapshot booted? use rescue rollback)" ;;
        esac
        # the target must be a read-only snapshot of the same btrfs
        case "$target" in
            /*) snapshot_path="${target%/}" ;;
            *) snapshot_path="/.snapshots/$target/snapshot" ;;
        esac
        [ -d "$snapshot_path" ] || die "snapshot not found: $snapshot_path"
        log "rollback: snapshotting current @ as before-rollback"
        snapper -c "$CONFIG" create --description "before-rollback" >/dev/null
        ts=$(date +%Y%m%d-%H%M%S)
        # @ is mounted AT /, so "/@" is not a path: renaming needs the btrfs
        # top level (subvolid=5), where @ and @snapshots are plain directories
        dev=$(findmnt -n -o SOURCE / | sed 's/\[.*//')
        work=$(mktemp -d /run/samurai-rollback.XXXXXX)
        top="$work/top"; new="$work/new"; mkdir "$top" "$new"
        cleanup() { umount -R "$new" 2>/dev/null || true; umount "$top" 2>/dev/null || true
                    rmdir "$new" "$top" "$work" 2>/dev/null || true; }
        trap cleanup EXIT
        mount -o subvolid=5 "$dev" "$top" || die "cannot mount the btrfs top level of $dev"
        [ ! -e "$top/@.rollback-stage" ] || die "a previous rollback left @.rollback-stage: delete it first (btrfs subvolume delete)"
        btrfs subvolume snapshot "$snapshot_path" "$top/@.rollback-stage"   # writable copy of the target
        log "rollback: renaming subvolumes (old @ -> @-broken-$ts)"
        mv "$top/@" "$top/@-broken-$ts"
        if ! mv "$top/@.rollback-stage" "$top/@"; then
            mv "$top/@-broken-$ts" "$top/@"
            die "could not move the restored root into place; nothing changed"
        fi
        # the ESP is not part of snapshots: put the restored root's own kernels
        # and initramfs images back on it (fstab targets subvol=@, unchanged)
        log "rollback: restoring kernels, initramfs and boot entries on the ESP"
        mount -o subvol=@ "$dev" "$new"
        for d in boot dev proc sys run var/log var/cache; do mount --rbind "/$d" "$new/$d" && mount --make-rslave "$new/$d"; done
        if ! chroot "$new" /bin/sh -euc "$RESTORE_BOOT"; then
            die "root restored, but rebuilding the boot files failed: do NOT reboot yet; fix it or run 'samurai rescue rollback' from the live ISO"
        fi
        log "rollback complete. previous system kept as subvolume @-broken-$ts (delete it when satisfied)"
        echo "Rollback complete. Reboot now: systemctl reboot"
        ;;

    -h|--help|help)
        echo "usage: samurai snap {list [--json]|create|delete|diff|restore-file|repair|rollback} [args]"
        ;;

    *)
        die "usage: samurai snap {list|create|delete|diff|restore-file|repair|rollback} [args]" 2
        ;;
esac
